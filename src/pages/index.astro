---
import Base from '../layouts/Base.astro';
import Counter from '../components/Counter.astro';
import Bi from '../components/Bi.astro';
import { stats } from '../lib/content';
import { posts } from '../data/news';
import { mainPartners } from '../data/partners';

// Years in the market: computed live so it is always current (climbs from the founding
// year the client sets in the admin).
const year = new Date().getFullYear();

// ── EDITABLE CONTENT ────────────────────────────────────────────────────────
// Every text and image on this page is a field in this object: the exact surface
// the admin dashboard edits. The markup below is a pure template that renders
// whatever is here. Bilingual fields are { en, ar } (natural fusha, not literal).
//
// STRUCTURE (Nasser's brief): the homepage is a still "magazine cover" that
// welcomes entry; scrolling down reveals the "الفهرس / contents": all seven routable
// section covers laid out at once, four over three. Each card opens that section's
// page. Photos are section-cover placeholders in the right shape, swapped for Amal's
// real assets via the admin.
const content = {
  cover: {
    eyebrow: { en: `Since ${stats.founded} · Jeddah, Saudi Arabia`, ar: `منذ عام ${stats.founded} · جدة، المملكة العربية السعودية` },
    titleHtml: {
      en: 'Pioneers in <span class="serif-note" style="color:var(--gold-bright)">flexible packaging</span><br>solutions and applications',
      ar: 'الرواد في حلول وتطبيقات <span class="serif-note" style="color:var(--gold-bright)">التغليف المرن</span>',
    },
    lede: {
      en: "A global leader in developing and producing responsible packaging for food, beverage, pharmaceutical, medical, home and personal-care brands.",
      ar: "شركة رائدة عالمياً في تطوير وإنتاج تغليف مسؤول لعلامات الأغذية والمشروبات والأدوية والمنتجات الطبية ومستلزمات المنزل والعناية الشخصية.",
    },
    image: "/images/hero.jpg",
    imageAlt: { en: "Printopack production", ar: "الإنتاج في برنتوباك" },
    scroll: { en: "Scroll to explore", ar: "مرّر للاستكشاف" },
  },
  contents: {
    eyebrow: { en: "The contents", ar: "الفهرس" },
    title: { en: "Explore Printopack", ar: "استكشف برنتوباك" },
    lede: {
      en: "Seven sections, one factory. Every part of the company, laid out in full.",
      ar: "سبعة أقسام، مصنع واحد. أجزاء الشركة كاملةً أمامكم.",
    },
    open: { en: "Open section", ar: "افتح القسم" },
    // The seven main sections, in Nasser's order. Each routes to its landing page.
    cards: [
      { href: "/about",    img: "/images/section-about.webp",           name: { en: "About Us",         ar: "من نحن" },          desc: { en: "Our story, people, plant and responsibility since 1997.", ar: "قصتنا وفريقنا ومصنعنا ومسؤوليتنا منذ عام 1997." } },
      { href: "/quality",  img: "/images/section-quality.webp",  name: { en: "Quality System",   ar: "نظام الجودة" },      desc: { en: "Certificates, quality assurance and in-house lab testing.", ar: "الشهادات وضمان الجودة والفحص المخبري الداخلي." } },
      { href: "/products", img: "/images/section-products.webp",             name: { en: "Products",         ar: "المنتجات" },        desc: { en: "Flexible packaging for every category, made to order.", ar: "تغليف مرن لكل فئة، يُصنع حسب الطلب." } },
      { href: "/partners", img: "/images/section-partners.webp",    name: { en: "Success Partners", ar: "شركاء النجاح" },    desc: { en: `The brands we print for, across ${stats.countries} countries.`, ar: `العلامات التي نطبع لها في أكثر من ${stats.countries} دولة.` } },
      { href: "/news-gallery", img: "/images/section-news.webp",         name: { en: "News & Gallery",   ar: "الأخبار والمعرض" }, desc: { en: "Latest news and events, plus our photo and video gallery.", ar: "أحدث الأخبار والفعاليات ومعرض الصور والفيديو." } },
      { href: "/careers",  img: "/images/section-careers.webp",             name: { en: "Careers",          ar: "الوظائف" },         desc: { en: "Open roles and how to join the Printopack team.", ar: "الوظائف المتاحة وكيفية الانضمام إلى فريق برنتوباك." } },
      { href: "/contact",  img: "/images/section-contact.webp",            name: { en: "Contact",          ar: "التواصل" },         desc: { en: "Reach our head office and regional offices across the region.", ar: "تواصل مع مقرنا الرئيسي ومكاتبنا الإقليمية في المنطقة." } },
    ],
  },
  counters: [
    // Every counter on the site now lives here: the client asked for them off the inner
    // pages and gathered on the home page, five to a row. This is the union of what the
    // seven pages used to show, with duplicates folded together.
    // Order set by the client, 2026-08-19. Top row is reach: how long, how far, how many
    // customers. Second row is the company itself: people, experience, plant. The
    // `counter-rowstart` marker has to travel with whichever counter opens the second row.
    { lead: stats.founded, from: stats.founded, value: year, label: "In the market", labelAr: "في السوق" },
    { prefix: "+", value: stats.countries, label: "Countries served", labelAr: "دولة حول العالم" },
    { value: stats.offices, label: "Regional offices", labelAr: "مكاتب إقليمية" },
    { prefix: "+", value: stats.customers, label: "Customers", labelAr: "عميل" },
    { prefix: "+", value: stats.partners, label: "Brand partners", labelAr: "علامة شريكة" },
    { prefix: "~", value: stats.employees, label: "Team members", labelAr: "من أفراد الفريق", cls: "counter-rowstart" },
    { value: stats.avgExp, label: "Avg. years per employee", labelAr: "متوسط سنوات الخبرة للموظف" },
    { prefix: "+", value: stats.totalExp, label: "Years of combined experience", labelAr: "سنة خبرة مجتمعة" },
    { value: stats.departments, label: "Production departments", labelAr: "أقسام إنتاجية" },
  ],
  partners: {
    eyebrow: { en: "Success partners", ar: "شركاء النجاح" },
    title: { en: "Trusted by leading brands", ar: "موضع ثقة العلامات الرائدة" },
    // The main partners, logo + name + country, the same card the Success Partners page
    // uses. This was a hardcoded run of client-1..20.png, so a partner added or removed in
    // the admin never reached the home page. Which partners count as "main" is the client's
    // choice, made in the admin; the home page always shows exactly that set.
    logos: mainPartners.map((p) => ({ img: p.logo, name: p.name, country: p.country, fit: p.fit, focus: p.focus })),
  },
  news: {
    eyebrow: { en: "News & events", ar: "الأخبار والأحداث" },
    title: { en: "The latest from Printopack", ar: "أحدث ما لدى برنتوباك" },
    link: { en: "All news", ar: "كل الأخبار" },
    read: { en: "Read more", ar: "اقرأ المزيد" },
    // The three most recent posts, straight from the content store, so publishing a post
    // in the admin changes the home page too. These used to be copied out by hand, which
    // meant the home page froze on three posts from 2023 no matter what was published.
    items: posts.slice(0, 3),
  },
};
const c = content;
const pad = (n: number) => String(n).padStart(2, "0");
---
<Base>
  <!-- ============ MAGAZINE COVER ============ -->
  <section class="cover">
    <div class="cover-bg"><img src={c.cover.image} alt={c.cover.imageAlt.en} fetchpriority="high" /></div>
    <div class="wrap-wide cover-inner">
      {/* No scrim and no panel. The hero photograph is a studio lineup shot on a flat
          #ececec sweep (sampled at every corner and edge, all within 1 of each other), so
          the section simply adopts that same colour. Photo and page become one continuous
          field with no visible seam, and the copy reads directly on it in brand blue. */}
      <span class="eyebrow"><Bi en={c.cover.eyebrow.en} ar={c.cover.eyebrow.ar} /></span>
      <h1 class="display-xl">
        <span class="i18n-en" set:html={c.cover.titleHtml.en} />
        <span class="i18n-ar" lang="ar" set:html={c.cover.titleHtml.ar} />
      </h1>
      <p class="cover-lede"><Bi en={c.cover.lede.en} ar={c.cover.lede.ar} /></p>
    </div>
    <a href="#contents" class="cover-scroll" aria-label="Scroll to contents">
      <span><Bi en={c.cover.scroll.en} ar={c.cover.scroll.ar} /></span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
    </a>
  </section>

  <!-- ============ THE CONTENTS (الفهرس): 7 routable section covers ============ -->
  <section id="contents" class="contents">
    <div class="wrap-wide">
      <div class="contents-head">
        <div>
          <span class="eyebrow"><Bi en={c.contents.eyebrow.en} ar={c.contents.eyebrow.ar} /></span>
          <h2 style="margin-top:14px"><Bi en={c.contents.title.en} ar={c.contents.title.ar} /></h2>
          <p class="lede" style="margin-top:16px"><Bi en={c.contents.lede.en} ar={c.contents.lede.ar} /></p>
        </div>
      </div>
    </div>

    <!-- All seven sections on the page at once, as an editorial contents index: a row of
         four over a row of three, both rows flush to the edges. It replaced a side-scroll
         shelf, which showed four and hid three behind a swipe. -->
    <div class="shelf-wrap wrap-wide">
      <ul class="contents-grid">
        {c.contents.cards.map((s, i) => (
          <li>
            <a href={s.href} class="fcard" draggable="false">
              <span class="fcard-media"><img src={s.img} alt={s.name.en} loading={i < 3 ? "eager" : "lazy"} decoding="async" draggable="false" /></span>
              <span class="fcard-scrim"></span>
              <span class="fcard-body">
                <span class="fcard-num">{pad(i + 1)} <span class="fcard-of">/ 07</span></span>
                <span class="fcard-name"><Bi en={s.name.en} ar={s.name.ar} /></span>
                <span class="fcard-desc"><Bi en={s.desc.en} ar={s.desc.ar} /></span>
                <span class="fcard-open"><Bi en={c.contents.open.en} ar={c.contents.open.ar} /> <span class="fcard-arrow" aria-hidden="true">&rarr;</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ COUNTERS ============ -->
  <section class="counters on-deep">
    <div class="wrap-wide counters-grid">
      {c.counters.map((n) => <Counter {...n} />)}
    </div>
  </section>

  <!-- ============ SUCCESS PARTNERS ============ -->
  <section class="partners-home">
    <div class="wrap-wide">
      <div class="section-head center">
        <span class="eyebrow plain" style="color:var(--gold)"><Bi en={c.partners.eyebrow.en} ar={c.partners.eyebrow.ar} /></span>
        <h2 style="margin-top:14px"><Bi en={c.partners.title.en} ar={c.partners.title.ar} /></h2>
      </div>
      <!-- Same card as the Success Partners page: logo, then name and country when the
           admin has filled them, so the two walls never drift apart. -->
      <ul class="logo-grid">
        {c.partners.logos.map((l) => (
          <li class="pcard">
            <span class="pcard-logo"><img src={l.img} alt={l.name.en || "Client brand"} loading="lazy" decoding="async" data-fit={l.fit || undefined} style={l.focus ? `object-position:${l.focus}` : undefined} /></span>
            <span class="pcard-meta">
              {(l.name.en || l.name.ar) && (
                <span class="pcard-name"><Bi en={l.name.en} ar={l.name.ar} /></span>
              )}
              {(l.country.en || l.country.ar) && (
                <span class="pcard-country">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                  <Bi en={l.country.en} ar={l.country.ar} />
                </span>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ NEWS ============ -->
  <section class="news-band on-deep">
    <div class="wrap-wide">
      <div class="section-head split-head">
        <div>
          <span class="eyebrow"><Bi en={c.news.eyebrow.en} ar={c.news.eyebrow.ar} /></span>
          <h2 style="margin-top:16px"><Bi en={c.news.title.en} ar={c.news.title.ar} /></h2>
        </div>
        <a href="/news" class="link-line on-dark"><Bi en={c.news.link.en} ar={c.news.link.ar} /></a>
      </div>
      <div class="news-grid">
        {c.news.items.map((n) => (
          <a href="/news" class="card news-card">
            <span class="card-img news-img"><img src={n.img} alt="" data-fit={n.fit || undefined} style={n.focus ? `object-position:${n.focus}` : undefined} loading="lazy" decoding="async" /></span>
            <span class="news-meta"><Bi en={n.cat.en} ar={n.cat.ar} /> · <span dir="ltr">{n.date}</span></span>
            <h3 class="news-title"><Bi en={n.title.en} ar={n.title.ar} /></h3>
            <span class="link-line on-dark news-read"><Bi en={c.news.read.en} ar={c.news.read.ar} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
</Base>

<style>
  /* ---------- magazine cover ---------- */
  /* Sampled from hero.jpg's own sweep. If the client replaces the hero with a photo on a
     different backdrop, this value has to be re-sampled or the seam becomes visible. */
  .cover{--studio:#ececec;position:relative;background:var(--studio);display:flex;flex-direction:column;color:var(--ink);overflow:hidden;padding-block:0}
  /* contain, never cover: the products sit in a row across the full width, so cropping the
     sides drops them. Letterboxing is invisible because the surround is the same colour. */
  /* hero.jpg is 1800x782, so at any viewport the photograph fills the full width exactly
     when the frame is 43.4vw tall (782/1800). That is as large as it can be drawn: past
     it `contain` starts letterboxing at the sides instead of growing. Capped at the
     image's own 782px so a very wide screen never upscales it into softness. */
  /* One variable drives both the frame and the pull below, so the narrow breakpoints only
     have to restate --frame. */
  .cover-bg{--frame:clamp(300px,43.4vw,782px);position:relative;height:var(--frame);
    /* hero.jpg carries roughly 16% empty sweep above the products, which reads as a gap
       under the lede rather than as part of the picture. Pull the frame up so most of it is
       absorbed. That sweep is the same #ececec as the section, so nothing is visibly
       clipped, and the products keep about 30px of clearance from the text. */
    margin-top:calc(var(--frame) * -0.133)}
  .cover-bg img{width:100%;height:100%;object-fit:contain;object-position:center bottom;display:block}
  /* order:-1 puts the copy above the photograph without reordering the markup, so the
     image still preloads first. */
  .cover-inner{order:-1;position:relative;z-index:2;padding-block:clamp(34px,4.4vw,64px) clamp(8px,1vw,14px)}
  .cover-inner .eyebrow{color:var(--blue)}
  .cover-inner .eyebrow::before{background:var(--gold)}
  /* Sized for a full sentence rather than the old two-word headline: a smaller clamp and a
     wider measure so "Pioneers in flexible packaging / solutions and applications" sits on
     two clean lines instead of towering through a 16ch box at display-xl size. */
  .cover h1{margin:16px 0 18px;max-width:24ch;color:var(--blue);font-size:clamp(32px,4.4vw,64px);line-height:1.05}
  .cover-lede{font-size:clamp(15.5px,1.35vw,18.5px);color:var(--muted);max-width:52ch;font-weight:300;line-height:1.6;margin:0}
  .cover-scroll{position:absolute;z-index:3;left:50%;transform:translateX(-50%);bottom:16px;display:flex;flex-direction:column;align-items:center;gap:6px;color:var(--blue);font-family:var(--display);font-size:11px;letter-spacing:.2em;text-transform:uppercase}
  .cover-scroll:hover{color:var(--gold-bright)}
  .cover-scroll svg{width:22px;height:22px}
  [dir="rtl"] .cover-scroll{transform:translateX(50%)}

  /* ---------- contents (الفهرس) ---------- */
  /* One rhythm for the whole page. Each band carries half the gap, so every boundary
     between two of them is the same height. The contents block takes a full gap on top
     because the hero bleeds to its own edge and contributes nothing to that join. */
  .contents,.counters,.partners-home,.news-band{padding-block:var(--band-y)}
  .contents{padding-top:calc(var(--band-y) * 2)}
  .contents-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px}
  .contents-head .lede{max-width:56ch}

  .shelf-wrap{margin-top:clamp(30px,4vw,46px)}
  /* Twenty-four columns so all seven cards are one width. Every card spans 6, which is a
     quarter of the row, so the bottom three match the top four exactly rather than
     stretching to fill the row. Three spare columns sit each side of the bottom row, which
     centres it: 24 less three cards of 6 leaves 6, split evenly. The client asked for equal
     sizes, and centring keeps the leftover space symmetrical instead of leaving a hole on
     one side that would also swap sides in RTL. */
  .contents-grid{display:grid;grid-template-columns:repeat(24,1fr);gap:22px}
  .contents-grid > li{grid-column:span 6}
  .contents-grid > li:nth-child(5){grid-column:4 / span 6}
  .contents-grid > li:nth-child(6){grid-column:10 / span 6}
  .contents-grid > li:nth-child(7){grid-column:16 / span 6}
  .fcard,.fcard img{-webkit-user-drag:none}
  /* Two up: six cards pair off and the seventh runs full width to close the block. */
  @media(max-width:1140px){
    .contents-grid{grid-template-columns:repeat(2,1fr)}
    .contents-grid > li,
    .contents-grid > li:nth-child(5),
    .contents-grid > li:nth-child(6){grid-column:auto}
    /* the odd seventh keeps the pair width and centres, rather than running full bleed */
    .contents-grid > li:nth-child(7){grid-column:1 / -1;width:calc((100% - 22px) / 2);justify-self:center}
  }
  @media(max-width:640px){
    .contents-grid{grid-template-columns:1fr;gap:16px}
    .contents-grid > li,
    .contents-grid > li:nth-child(5),
    .contents-grid > li:nth-child(6){grid-column:auto}
    .contents-grid > li:nth-child(7){grid-column:auto;width:auto;justify-self:stretch}
  }
  /* Shorter than the old shelf card: two rows of the previous height would have run to
     roughly a thousand pixels of contents index before the counters. */
  .fcard{position:relative;display:block;height:clamp(300px,26vw,380px);border-radius:var(--radius);overflow:hidden;background:var(--navy-deep);border:1px solid var(--line)}
  .fcard-media{position:absolute;inset:0}
  .fcard-media img{width:100%;height:100%;object-fit:cover;filter:brightness(.86) saturate(1.08)}
  .fcard-scrim{position:absolute;inset:0;background:linear-gradient(0deg,rgba(9,24,41,.95) 0%,rgba(9,24,41,.86) 30%,rgba(9,24,41,.62) 50%,rgba(9,24,41,.3) 68%,transparent 88%)}
  .fcard:hover .fcard-media img{filter:brightness(1) saturate(1.12)}
  .fcard-body{position:absolute;inset:auto 0 0 0;z-index:2;display:flex;flex-direction:column;padding:clamp(22px,2vw,28px);color:var(--paper)}
  .fcard-num{font-family:var(--display);font-size:13px;font-weight:500;letter-spacing:.18em;color:var(--gold-bright);margin-bottom:12px}
  .fcard-of{color:#fff}
  .fcard-name{font-family:var(--display);font-weight:300;font-size:clamp(26px,2.4vw,32px);line-height:1.06}
  .fcard-desc{margin-top:10px;font-size:14px;line-height:1.55;color:#fff;max-width:34ch}
  .fcard-open{margin-top:16px;font-family:var(--display);font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--paper);display:inline-flex;align-items:center;gap:9px}
  .fcard:hover .fcard-open{color:var(--gold-bright)}
  .fcard::after{content:"";position:absolute;inset:0;z-index:3;border:2px solid transparent;border-radius:var(--radius)}
  .fcard:hover::after{border-color:var(--gold-bright)}
  [dir="rtl"] .fcard-arrow{display:inline-block;transform:scaleX(-1)}

  /* ---------- counters ---------- */
  /* Five to a row, at the client's request. Ten tracks rather than five: every counter
     spans 2, so all nine are one width, and the second row of four starts one track in,
     which leaves a single spare track each side and keeps it centred under the first. */
  .counters-grid{display:grid;grid-template-columns:repeat(10,1fr);gap:44px 26px;max-width:2000px;padding-inline:clamp(20px,2.4vw,44px)}
  .counters-grid > :global(.counter){grid-column:span 2}
  /* Astro drops this component's hoisted <script> in beside the first counter, so the grid
     has a tenth child that is not a counter. It must not hold a track, and the second row
     is marked with a class rather than :nth-child, which that stray child would offset. */
  .counters-grid > :global(script){display:none}
  .counters-grid > :global(.counter-rowstart){grid-column:2 / span 2}
  /* five across is a narrower column than three, so the figures come down to suit it, and
     "1997 - 2026" is the widest of them at eleven characters */
  .counters-grid :global(.counter-num){font-size:clamp(28px,2.8vw,42px)}

  /* ---------- partners ---------- */
  /* Partner cards, matching the Success Partners wall: logo, then name and country. The
     meta block collapses when the admin has filled neither, so an all-logo state still
     reads as a clean grid. Four across rather than five, because the name and country
     need the extra width. */
  .logo-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}
  .pcard{background:var(--paper);display:flex;flex-direction:column}
  .pcard-logo{position:relative;aspect-ratio:16/10;display:block}
  .pcard-logo img{position:absolute;inset:0;margin:auto;max-width:calc(100% - 24px);max-height:calc(100% - 26px);mix-blend-mode:multiply}
  .pcard-logo img[data-fit]{margin:0;width:100%;height:100%;max-width:none;max-height:none;padding:13px 12px;box-sizing:border-box}
  .pcard:hover .pcard-logo img{filter:grayscale(1);opacity:.55}
  .pcard-meta:empty{display:none}
  .pcard-meta{display:flex;flex-direction:column;gap:5px;padding:0 18px 18px;margin-top:-4px}
  .pcard-name{font-family:var(--display);font-size:16px;font-weight:400;color:var(--ink);line-height:1.2}
  .pcard-country{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;letter-spacing:.02em;color:var(--muted)}
  .pcard-country svg{width:14px;height:14px;color:var(--gold);flex:none}
  .logo:hover img{filter:grayscale(1);opacity:.55}

  /* ---------- news ---------- */
  .split-head{display:flex;justify-content:space-between;align-items:flex-end;max-width:none}
  /* Reflows on its own instead of holding three columns down to 920px and then snapping
     to one. Between roughly 700 and 920px the fixed three-column version squeezed each
     card to ~200px, which is what the client saw as "not responsive". auto-fit drops to
     two columns and then one at the widths where the cards actually stop fitting. */
  /* The global section rhythm puts 132px under the partners wall and another 132px over
     the band below it, a 264px trough the client reads as dead space. Halved on the
     partners side; the band keeps its own padding because a coloured band needs the room
     to read as a band. */
  /* Both sides of this boundary take the same value, so the blue band does not read
     as having more air above its heading than the white has below the logos. */
  /* Dark blue, matching the footer, per the client's note that sections need colour
     separation between them. */
  .news-band .news-meta{color:var(--gold-on-dark)}
  .news-band .news-title,.news-band .section-head h2{color:var(--white)}
  .news-band .eyebrow{color:var(--gold-on-dark);display:flex;line-height:1;justify-content:inherit}
  .news-band .eyebrow::before{background:var(--gold-on-dark)}
  .news-band .link-line.on-dark{color:var(--gold-on-dark)}
  .news-band .link-line.on-dark:hover{color:var(--white)}
  .news-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:34px;align-items:stretch}
  .news-card{display:flex;flex-direction:column}
  .news-img{aspect-ratio:3/2}
  .news-meta{display:block;margin-top:18px;font-family:var(--display);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
  .news-title{margin:10px 0 16px;font-size:clamp(20px,1.7vw,25px)}
  .news-read{font-size:12px;margin-top:auto;align-self:flex-start}

  /* The header switches to its mobile bar at 720px, so the hero follows it rather than
     waiting for 560px. Without this, a 561-720px screen kept the 86vh cover and the page
     still looked like it ended at the fold. Type is tuned further down at 560px. */
  @media(max-width:720px){
    .cover-bg{--frame:clamp(200px,52vw,300px)}
  }

  @media(max-width:1000px){
    /* three across from here: five columns of a big figure plus a tracked label stop
       fitting well before the tablet breakpoint */
    .counters-grid{grid-template-columns:repeat(3,1fr);gap:36px 24px}
    .counters-grid > :global(.counter),
    .counters-grid > :global(.counter-rowstart){grid-column:auto}
    /* no column override here: auto-fit above already drops to two columns and then one,
       at the widths where the cards stop fitting. Forcing 1fr from 1000px down was what
       gave tablets one enormous card per row. */
    .news-grid{gap:40px}
    .split-head{flex-direction:column;align-items:flex-start;gap:16px}
    .logo-grid{grid-template-columns:repeat(3,1fr)}
    /* stack the head, but KEEP the arrows: at these widths there is no visible
       scrollbar and a mouse cannot swipe, so the arrows are the only way to reach
       cards 4-7. They sit just under the intro. */
    .contents-head{flex-direction:column;align-items:flex-start;gap:22px}
  }
  @media(max-width:560px){
    /* Two across, not one. A counter is a big number and a short label, and six of them
       stacked single-file made a 779px band on a 375px phone: a whole screen of scrolling
       past numbers. Two across halves that and matches what the company page already did. */
    .counters-grid{grid-template-columns:repeat(2,1fr);gap:34px 18px}
    .counters-grid > :global(.counter),
    .counters-grid > :global(.counter-rowstart){grid-column:auto}
    .logo-grid{grid-template-columns:repeat(2,1fr)}
    /* The hero was 82vh: with the header that is 735px of an 812px screen, so the page
       looked like it ended at the fold. It is also a 1800x782 landscape photo being
       cover-cropped into a portrait box, which threw away 73% of its width and left one
       pasta tube instead of the product lineup. A shorter hero fixes both, because a less
       portrait box crops less. svh is the viewport WITHOUT the browser's address bar, so
       the hero does not grow by ~60px the moment the bar retracts; vh stays as a fallback. */
    .cover-bg{--frame:clamp(170px,46vw,240px)}
    /* The height was really being set by the copy, not by min-height: the headline clamps to
       a 36px floor, so on a 375px screen it wrapped to four lines and pushed the hero past
       the fold on its own. Sizing the type for the screen is what actually shortens it. */
    .cover h1{font-size:30px;margin:12px 0 16px}
    .cover-lede{font-size:15px;line-height:1.55}
    .cover-inner{padding-bottom:clamp(30px,6vw,52px)}
    /* bias the crop slightly above centre: the packs sit high in the frame */

    /* The scrim is a percentage gradient, so shortening the hero compressed its dark end and
       left the headline sitting on bright pasta and a white bottle. On a phone the text also
       spans the full width, so the desktop's diagonal (dark on the left only) does not help.
       A straight bottom-up wash, darker and reaching higher, keeps the copy legible. */
  }

  /* Small phones (iPhone SE and similar, 320px). The headline still wraps to four lines at
     30px there, which put the hero back at 98% of a 568px screen. */
  @media(max-width:360px){
    .cover{min-height:50vh;min-height:50svh}
    .cover h1{font-size:26px;margin:10px 0 12px}
    .cover-lede{font-size:14px}
    .cover-inner{padding-bottom:24px}
  }
</style>

