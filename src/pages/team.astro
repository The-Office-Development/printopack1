---
import Base from '../layouts/Base.astro';
import Bi from '../components/Bi.astro';
import { collection, stats } from '../lib/content';
const year = new Date().getFullYear();

/** A bio as paragraphs: blank lines separate them, single line breaks stay inside one. */
const paras = (s: unknown): string[] =>
  String(s || '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

// ── EDITABLE CONTENT (bilingual) ─────────────────────────────────────────────
// Team (Nasser's Page 1 subsection). He asked for manager names + photos; the live
// site has no team page, so names/photos are client-gated: leadership is shown by role
// with a photo/monogram slot (no invented names). The admin swaps each slot for a real
// name + photo. Employee count (~400) is real. Nasser's total-years and average-years-of-
// experience counters are now here: the average is an admin field, the total is derived
// from it, so neither waits on a number the client has to remember to keep in step.
const content = {
  meta: {
    title: "Our Team - Printopack",
    description: "The people behind Printopack: a team of around 400 across production, quality, engraving and commercial, led by experienced managers in Jeddah.",
  },
  header: {
    eyebrow: { en: "Our team", ar: "فريق العمل" },
    title: { en: "The people behind Printopack.", ar: "الأشخاص الذين يقفون خلف برنتوباك." },
    lede: {
      en: "Packaging is made by people. Around 400 of them, across the press floor, the engraving room, the lab and the offices, turn each brief into a finished product, run after run.",
      ar: "التغليف يصنعه الناس؛ نحو 400 شخص في أرضية المصنع وغرفة الحفر والمختبر والمكاتب يحوّلون كل موجزٍ إلى منتجٍ نهائي، تشغيلةً بعد أخرى.",
    },
  },
  leadership: {
    eyebrow: { en: "Leadership", ar: "القيادة" },
    title: { en: "Led by people who know packaging.", ar: "يقودها أشخاص يعرفون التغليف." },
    lede: {
      en: "Each part of the business is run by a manager with deep experience in flexible packaging.",
      ar: "يدير كل جزء من الأعمال مديرٌ ذو خبرة عميقة في التغليف المرن.",
    },
    readMore: { en: "Read more", ar: "اقرأ المزيد" },
    // Each member has a name slot (client-gated, filled via admin) + role, photo/monogram
    // and a note. When `name` is filled it becomes the heading and the role moves to a
    // subtitle; until then the role heads the card. The admin adds/edits/removes these.
    // Sourced from the content store (admin-managed). Blank name -> the card shows the role
    // as its heading (no invented name), exactly as before.
    members: collection('team').map((m) => ({
      photo: m.photo, mono: m.mono, fit: m.photoFit, focus: m.photoFocus,
      name: { en: m.name, ar: m.nameAr },
      role: { en: m.role, ar: m.roleAr },
      bio: { en: paras(m.bio), ar: paras(m.bioAr) },
      experience: Number(m.experience) || 0,
      email: String(m.email || '').trim(),
    })),
  },
  culture: {
    eyebrow: { en: "Life at Printopack", ar: "الحياة في برنتوباك" },
    quote: {
      en: "We hire for craft and care, then give people the tools and the standard to do their best work.",
      ar: "نوظّف على أساس الإتقان والاهتمام، ثم نمنح الناس الأدوات والمعيار ليقدّموا أفضل ما لديهم.",
    },
    link: { en: "Explore careers", ar: "استكشف الوظائف" },
  },
  cta: {
    eyebrow: { en: "Work with our team", ar: "اعمل مع فريقنا" },
    title: { en: "Have a project in mind?", ar: "لديك مشروع في ذهنك؟" },
    button: { en: "Request a quote", ar: "اطلب عرض سعر" },
  },
};
const c = content;
---
<Base title={c.meta.title} description={c.meta.description}>
  <!-- PAGE HEADER -->
  <section class="page-head">
    <div class="wrap-wide">
      <div class="page-head-inner">
        <span class="eyebrow"><Bi en={c.header.eyebrow.en} ar={c.header.eyebrow.ar} /></span>
        <h1><Bi en={c.header.title.en} ar={c.header.title.ar} /></h1>
        <p class="lede"><Bi en={c.header.lede.en} ar={c.header.lede.ar} /></p>
      </div>
    </div>
  </section>


  <!-- LEADERSHIP. The card is the photo, the name and the title only (client, 2026-09-13), so
       the grid stays even however long a bio is. Everything else opens in the profile overlay,
       from the photo or from "Read more". -->
  <section class="leadership">
    <div class="wrap-wide">
      <div class="section-head">
        <span class="eyebrow"><Bi en={c.leadership.eyebrow.en} ar={c.leadership.eyebrow.ar} /></span>
        <h2 style="margin-top:16px"><Bi en={c.leadership.title.en} ar={c.leadership.title.ar} /></h2>
        <p class="lede"><Bi en={c.leadership.lede.en} ar={c.leadership.lede.ar} /></p>
      </div>
      <div class="team-grid">
        {c.leadership.members.map((m, i) => {
          const label = m.name.en || m.role.en;
          return (
          <div class="member">
            <button type="button" class="avatar avatar-open" data-profile={`member-${i}`} aria-haspopup="dialog" aria-label={`Open the profile of ${label}`}>
              {m.photo
                ? <img src={m.photo} alt={label} loading="lazy" decoding="async" data-fit={m.fit || undefined} style={m.focus ? `object-position:${m.focus}` : undefined} />
                : <span class="avatar-mono" aria-hidden="true">{m.mono}</span>}
            </button>
            {m.name.en
              ? <><h3 class="member-name"><Bi en={m.name.en} ar={m.name.ar} /></h3><span class="member-role"><Bi en={m.role.en} ar={m.role.ar} /></span></>
              : <h3 class="member-name"><Bi en={m.role.en} ar={m.role.ar} /></h3>}
            <button type="button" class="link-line member-more" data-profile={`member-${i}`} aria-haspopup="dialog">
              <Bi en={c.leadership.readMore.en} ar={c.leadership.readMore.ar} />
            </button>

            <!-- This member's profile, rendered with the page and copied into the overlay when
                 it opens: no markup is assembled from strings at runtime. -->
            <template id={`member-${i}`}>
              <div class="pf-photo">
                {m.photo
                  ? <img src={m.photo} alt={label} data-fit={m.fit || undefined} style={m.focus ? `object-position:${m.focus}` : undefined} />
                  : <span class="pf-mono" aria-hidden="true">{m.mono}</span>}
              </div>
              <div class="pf-body">
                {m.name.en && <span class="pf-role"><Bi en={m.role.en} ar={m.role.ar} /></span>}
                <h2 class="pf-name" id="pf-title">
                  {m.name.en ? <Bi en={m.name.en} ar={m.name.ar} /> : <Bi en={m.role.en} ar={m.role.ar} />}
                </h2>
                {(m.experience > 0 || m.email) && (
                  <div class="pf-meta">
                    {m.experience > 0 && (
                      <span><Bi en={`${m.experience} years of experience`} ar={`سنوات الخبرة: ${m.experience}`} /></span>
                    )}
                    {m.email && <a href={`mailto:${m.email}`} dir="ltr">{m.email}</a>}
                  </div>
                )}
                {m.bio.en.length > 0 && (
                  <div class="pf-bio pf-bio-en">{m.bio.en.map((p) => <p>{p}</p>)}</div>
                )}
                {(m.bio.ar.length > 0 || m.bio.en.length > 0) && (
                  <div class="pf-bio pf-bio-ar" dir="rtl">{(m.bio.ar.length ? m.bio.ar : m.bio.en).map((p) => <p>{p}</p>)}</div>
                )}
              </div>
            </template>
          </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CULTURE BAND -->
  <section class="culture">
    <div class="culture-bg"><img src="/images/factory.jpg" alt="Inside the Printopack facility" loading="lazy" /></div>
    <div class="wrap culture-inner">
      <span class="eyebrow" style="color:var(--gold-bright)"><Bi en={c.culture.eyebrow.en} ar={c.culture.eyebrow.ar} /></span>
      <p class="culture-quote"><Bi en={c.culture.quote.en} ar={c.culture.quote.ar} /></p>
      <a href="/careers" class="link-line on-dark"><Bi en={c.culture.link.en} ar={c.culture.link.ar} /></a>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="wrap" style="text-align:center">
      <span class="eyebrow plain" style="color:var(--gold)"><Bi en={c.cta.eyebrow.en} ar={c.cta.eyebrow.ar} /></span>
      <h2 style="margin:16px 0 26px"><Bi en={c.cta.title.en} ar={c.cta.title.ar} /></h2>
      <a href="/contact" class="btn btn-gold"><Bi en={c.cta.button.en} ar={c.cta.button.ar} /></a>
    </div>
  </section>

  <!-- PROFILE OVERLAY. One shell for the whole page; the member's <template> fills it. Appears
       and disappears instantly: the site is motion-free. -->
  <div class="profile" id="member-profile" role="dialog" aria-modal="true" aria-labelledby="pf-title" hidden>
    <div class="pf-panel">
      <button class="pf-close" type="button" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <div class="pf-content"></div>
    </div>
  </div>
</Base>

<style>
  .page-head{padding-block:clamp(28px,3.4vw,48px) clamp(18px,2vw,28px);background:var(--cream);border-bottom:1px solid var(--line)}
  .page-head-inner{max-width:820px}
  .page-head h1{margin:20px 0 22px;font-size:clamp(40px,6vw,78px)}
  .page-head .lede{max-width:60ch}


  .leadership .section-head{max-width:640px}
  .leadership .lede{margin-top:18px}
  .team-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(26px,3vw,44px)}
  .member{text-align:start}
  /* The portrait carries this grid, so the circle scales with its column and caps at 180px.
     It was a fixed 76px, which cropped the 600x600 the admin asks for down to the head alone
     and showed far less than the dashboard preview (client content note, 2026-09-10). */
  .avatar{
    display:grid;place-items:center;width:100%;max-width:180px;aspect-ratio:1;border-radius:50%;
    overflow:hidden;background:var(--cream);border:1px solid var(--gold);margin-bottom:20px;
  }
  /* The photo is a <button>, so the UA's own box has to be cleared. No transition: the site
     is deliberately motion-free, the cue is the cursor plus the border. */
  .avatar-open{padding:0;font:inherit;color:inherit;cursor:pointer}
  .avatar-open:hover,.avatar-open:focus-visible{border-color:var(--navy)}
  .avatar img{width:100%;height:100%;object-fit:cover}
  .avatar-mono{font-family:var(--display);font-weight:400;font-size:clamp(23px,4vw,46px);letter-spacing:.04em;color:var(--navy)}
  .member-name{font-size:clamp(18px,1.5vw,21px);margin-bottom:8px}
  .member-role{display:block;font-family:var(--display);font-size:12px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:12px}
  .member-more{cursor:pointer}

  /* Profile overlay. The panel's contents are cloned from a <template> when it opens, so their
     rules are :global() anchored to the scoped .profile, the only form that is certain to reach
     DOM put there at runtime. */
  .profile{position:fixed;inset:0;z-index:200;background:rgba(9,24,41,.72);display:flex;align-items:center;justify-content:center;padding:clamp(12px,4vw,48px)}
  .profile[hidden]{display:none}
  .pf-panel{position:relative;background:var(--paper);width:min(920px,100%);max-height:min(88vh,780px);overflow-y:auto;border-radius:var(--radius);box-shadow:0 30px 70px rgba(0,0,0,.35)}
  .pf-close{position:absolute;top:12px;inset-inline-end:12px;z-index:2;width:42px;height:42px;display:inline-flex;align-items:center;justify-content:center;color:var(--ink);background:var(--paper);border:1px solid var(--line);border-radius:50%}
  .pf-close:hover,.pf-close:focus-visible{color:var(--gold-bright);border-color:var(--gold)}
  .pf-close svg{width:18px;height:18px}
  .pf-content{display:grid;grid-template-columns:minmax(200px,300px) 1fr;gap:clamp(22px,3vw,40px);padding:clamp(22px,3.4vw,44px)}
  .profile :global(.pf-photo){width:100%;aspect-ratio:1;align-self:start;overflow:hidden;display:grid;place-items:center;background:var(--cream);border:1px solid var(--line);border-radius:var(--radius)}
  .profile :global(.pf-photo img){width:100%;height:100%;object-fit:cover;display:block}
  .profile :global(.pf-mono){font-family:var(--display);font-size:clamp(40px,6vw,64px);letter-spacing:.04em;color:var(--navy)}
  .profile :global(.pf-body){min-width:0}
  .profile :global(.pf-role){display:block;font-family:var(--display);font-size:12px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);padding-inline-end:48px}
  .profile :global(.pf-name){font-size:clamp(26px,3vw,38px);margin:10px 0 14px;padding-inline-end:48px}
  .profile :global(.pf-meta){display:flex;flex-wrap:wrap;gap:6px 22px;padding-bottom:14px;margin-bottom:16px;border-bottom:1px solid var(--line);font-family:var(--display);font-size:14px;color:var(--muted)}
  .profile :global(.pf-meta a){color:var(--link)}
  .profile :global(.pf-meta a:hover){color:var(--link-hover)}
  /* pre-line keeps the single line breaks typed inside a paragraph in the admin. */
  .profile :global(.pf-bio p){font-size:15.5px;line-height:1.72;color:var(--ink);white-space:pre-line;max-width:64ch}
  .profile :global(.pf-bio p + p){margin-top:12px}
  .profile :global(.pf-bio-ar){display:none}
  :global([dir="rtl"]) .profile :global(.pf-bio-ar){display:block}
  :global([dir="rtl"]) .profile :global(.pf-bio-en){display:none}

  .culture{position:relative;color:var(--paper);overflow:hidden;padding-block:clamp(48px,6vw,84px)}
  .culture-bg{position:absolute;inset:0}
  .culture-bg img{width:100%;height:100%;object-fit:cover}
  .culture-bg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(9,24,41,.72),rgba(9,24,41,.86))}
  .culture-inner{position:relative;z-index:2;text-align:center;max-width:900px}
  .culture-quote{font-family:var(--display);font-weight:300;font-size:clamp(24px,3.4vw,42px);line-height:1.28;margin:22px auto 28px;max-width:24ch}

  @media(max-width:1000px){
    .team-grid{grid-template-columns:repeat(2,1fr);gap:40px 28px}
  }
  @media(max-width:700px){
    .pf-content{grid-template-columns:1fr}
    .profile :global(.pf-photo){max-width:220px}
  }
  @media(max-width:520px){
    .team-grid{grid-template-columns:1fr}
  }
</style>

<script>
  // Profile overlay: the photo or "Read more" copies that member's <template> into the panel.
  // Closes on the x, the backdrop, or Esc, and hands focus back to whatever opened it.
  const dlg = document.getElementById('member-profile');
  const panel = dlg?.querySelector('.pf-panel') as HTMLElement | null;
  const content = dlg?.querySelector('.pf-content') as HTMLElement | null;
  let opener: HTMLElement | null = null;

  const close = () => {
    if (!dlg || !content) return;
    dlg.hidden = true;
    content.replaceChildren();
    document.body.style.overflow = '';
    opener?.focus();
    opener = null;
  };

  document.querySelectorAll<HTMLElement>('[data-profile]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tpl = document.getElementById(btn.dataset.profile || '') as HTMLTemplateElement | null;
      if (!dlg || !content || !tpl) return;
      content.replaceChildren(tpl.content.cloneNode(true));
      opener = btn;
      dlg.hidden = false;
      document.body.style.overflow = 'hidden';
      if (panel) panel.scrollTop = 0;
      dlg.querySelector<HTMLElement>('.pf-close')?.focus();
    });
  });

  dlg?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    // Outside the panel, or on the x, closes. Anything inside the panel stays open.
    if (!t.closest('.pf-panel') || t.closest('.pf-close')) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dlg && !dlg.hidden) close();
  });
</script>
