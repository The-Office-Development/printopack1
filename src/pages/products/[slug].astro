---
import Base from '../../layouts/Base.astro';
import Bi from '../../components/Bi.astro';
import { categories, filters, subItemsOf } from '../../data/products';
import { collection } from '../../lib/content';

// Product-group detail page (catalogue model, no cart): image + narrative + enquiry.
// One static page per group; copy comes from the shared data module and the bilingual
// block below, edited via the admin CMS in production. Individual products inside a
// group are client-added; this page presents the group and routes to a quote.

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}

const { cat } = Astro.props;
// The sections inside this group, in the client's order. A group with none (Bags
// Measurements) simply does not render the block.
const items = subItemsOf(cat.name.en);
const groupFilter = filters.find((f) => f.key === cat.group);
const related = categories.filter((c) => c.group === cat.group && c.slug !== cat.slug).slice(0, 3);
const more = related.length ? related : categories.filter((c) => c.slug !== cat.slug).slice(0, 3);
const quoteMail = `mailto:mkt@printopack.com.sa?subject=${encodeURIComponent(`Quote request: ${cat.name.en}`)}`;

const t = {
  note: {
    en: "Every structure in this range is made to order: we build the laminate, print and finish to your brief, so the pack on your shelf is yours alone.",
    ar: "كل تركيبٍ في هذه المجموعة يُصنع حسب الطلب: نبني التصفيح ونطبع وننهي وفق موجزكم، ليكون ما على رفّكم لكم وحدكم.",
  },
  meta: [
    { en: "Price on request", ar: "السعر عند الطلب" },
    { en: "Made to order", ar: "يُصنع حسب الطلب" },
    { en: "Offered by consultation", ar: "يُقدَّم بالاستشارة" },
  ],
  quote: { en: "Request a quote", ar: "اطلب عرض سعر" },
  talk: { en: "Talk to our team", ar: "تحدّث إلى فريقنا" },
  crumb: { en: "Products", ar: "المنتجات" },
  inRange: {
    eyebrow: { en: "In this range", ar: "ضمن هذه المجموعة" },
    title: { en: "What we pack in this category.", ar: "ما نعبّئه في هذه الفئة." },
    // Stands in until Printopack writes each section's own description in the admin.
    pending: {
      en: "Made to order in our Jeddah plant, with the structure and barrier built around this product. Ask us for the specification.",
      ar: "يُصنع حسب الطلب في مصنعنا بجدة، بتركيبٍ وحاجزٍ مبنيّين حول هذا المنتج. اطلبوا منّا المواصفات.",
    },
  },
  // Size charts, which read differently from a product section.
  chart: {
    tag: { en: "Measurements", ar: "المقاسات" },
    lede: {
      en: "The sizes we produce in this range, with their dimensions. Open the chart to read it full size, or ask us and we will send the specification.",
      ar: "المقاسات التي نُنتجها في هذه المجموعة بأبعادها. افتحوا الجدول لقراءته بحجمه الكامل، أو اطلبوا منّا المواصفات ونرسلها إليكم.",
    },
    zoom: { en: "Open full size", ar: "افتح بالحجم الكامل" },
    pending: {
      en: "The measurement chart for this range is being prepared and will appear here.",
      ar: "جدول المقاسات لهذه المجموعة قيد الإعداد وسيظهر هنا.",
    },
  },
  standard: {
    eyebrow: { en: "The Printopack standard", ar: "معيار برنتوباك" },
    title: { en: "What every order includes.", ar: "ما يشمله كل طلب." },
    // Admin-managed: "What every order includes" is the client's own promise, so they own
    // the wording and the number of points.
    items: collection('standard').map((x) => ({
      t: { en: x.title, ar: x.titleAr || x.title },
      d: { en: x.text, ar: x.textAr || x.text },
    })),
  },
  more: {
    eyebrow: { en: "Keep browsing", ar: "تابع التصفّح" },
    titleRelated: { en: "More in this range.", ar: "المزيد في هذه المجموعة." },
    titleAll: { en: "More from the catalogue.", ar: "المزيد من الكتالوج." },
    link: { en: "View & enquire", ar: "عرض واستفسار" },
    allLabel: { en: "product groups", ar: "مجموعة منتجات" },
    allCta: { en: "View all products", ar: "عرض كل المنتجات" },
  },
};
---
<Base
  title={`${cat.name.en} - Products - Printopack`}
  description={`${cat.desc.en} Made to order in Jeddah and offered by consultation.`}
>
  <!-- BREADCRUMB -->
  <nav class="crumbs" aria-label="Breadcrumb">
    <div class="wrap-wide">
      <a href="/products"><Bi en={t.crumb.en} ar={t.crumb.ar} /></a>
      <span aria-hidden="true">/</span>
      <span class="crumb-here"><Bi en={cat.name.en} ar={cat.name.ar} /></span>
    </div>
  </nav>

  <!-- GROUP -->
  <section class={"pdp" + (cat.isMeasurements ? " pdp-chart" : "")}>
    <div class="wrap-wide pdp-grid">
      <div class="pdp-media">
        {cat.isMeasurements
          ? <a href={cat.img} target="_blank" rel="noopener" class="pdp-chart-link">
              <img src={cat.img} alt={cat.name.en} decoding="async" />
              <span class="chart-zoom"><Bi en={t.chart.zoom.en} ar={t.chart.zoom.ar} /></span>
            </a>
          : <img src={cat.img} alt={cat.name.en} decoding="async" />}
      </div>
      <div class="pdp-info">
        {groupFilter && <span class="eyebrow"><Bi en={groupFilter.label.en} ar={groupFilter.label.ar} /></span>}
        <h1><Bi en={cat.name.en} ar={cat.name.ar} /></h1>
        <p class="lede"><Bi en={cat.desc.en} ar={cat.desc.ar} /></p>
        <p class="pdp-note"><Bi en={t.note.en} ar={t.note.ar} /></p>

        <div class="pdp-meta">
          {t.meta.map((m) => <span><Bi en={m.en} ar={m.ar} /></span>)}
        </div>

        <div class="pdp-actions">
          <a href={quoteMail} class="btn btn-gold"><Bi en={t.quote.en} ar={t.quote.ar} /></a>
          <a href="/contact" class="link-line"><Bi en={t.talk.en} ar={t.talk.ar} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTIONS INSIDE THIS GROUP. The client's own sub-items, in their order. Each carries a
       photo and a description that Printopack fills in through the admin; until then the item
       renders as a clean named section rather than an empty frame. -->
  {items.length > 0 && (
    <section class="range">
      <div class="wrap-wide">
        <div class="section-head">
          <span class="eyebrow plain" style="color:var(--gold)"><Bi en={t.inRange.eyebrow.en} ar={t.inRange.eyebrow.ar} /></span>
          <h2 style="margin-top:14px"><Bi en={t.inRange.title.en} ar={t.inRange.title.ar} /></h2>
        </div>
        <div class="range-list">
          {items.map((s, i) => (
            s.isMeasurements ? (
              <!-- A size chart, not a product. Full width and as large as the column allows,
                   shown whole rather than cropped, and openable at full size because the
                   dimensions on it are small type that has to be legible. -->
              <article class="chart">
                <div class="chart-head">
                  <span class="chart-tag"><Bi en={t.chart.tag.en} ar={t.chart.tag.ar} /></span>
                  <h3><Bi en={s.name.en} ar={s.name.ar} /></h3>
                  <p><Bi en={s.desc.en || t.chart.lede.en} ar={s.desc.ar || t.chart.lede.ar} /></p>
                </div>
                {s.image
                  ? <a class="chart-figure" href={s.image} target="_blank" rel="noopener">
                      <img src={s.image} alt={s.name.en} loading="lazy" decoding="async" />
                      <span class="chart-zoom"><Bi en={t.chart.zoom.en} ar={t.chart.zoom.ar} /></span>
                    </a>
                  : <div class="chart-figure is-empty">
                      <span class="chart-ph" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M3 4h18v16H3z"/><path d="M3 9h18M3 14h18M9 4v16M15 4v16"/></svg></span>
                      <span class="chart-pending"><Bi en={t.chart.pending.en} ar={t.chart.pending.ar} /></span>
                    </div>}
              </article>
            ) : (
              <article class={"range-row" + (i % 2 ? " reverse" : "")}>
                <div class="range-media">
                  <div class="card-img">
                    {s.image
                      ? <img src={s.image} alt={s.name.en} loading="lazy" decoding="async" />
                      : <span class="img-ph" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M3 9l9-5 9 5v11H3z"/><path d="M3 9h18M9 20v-6h6v6"/></svg></span>}
                  </div>
                </div>
                <div class="range-body">
                  <span class="range-num">{String(i + 1).padStart(2, "0")}</span>
                  <h3><Bi en={s.name.en} ar={s.name.ar} /></h3>
                  <p><Bi en={s.desc.en || t.inRange.pending.en} ar={s.desc.ar || t.inRange.pending.ar} /></p>
                </div>
              </article>
            )
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- THE PRINTOPACK STANDARD -->
  <section class="on-navy pdp-standard">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow"><Bi en={t.standard.eyebrow.en} ar={t.standard.eyebrow.ar} /></span>
        <h2 style="margin-top:16px"><Bi en={t.standard.title.en} ar={t.standard.title.ar} /></h2>
      </div>
      <div class="std-grid">
        {t.standard.items.map((s) => (
          <div class="std-item">
            <h3><Bi en={s.t.en} ar={s.t.ar} /></h3>
            <p><Bi en={s.d.en} ar={s.d.ar} /></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MORE IN THIS RANGE -->
  <section class="pdp-more">
    <div class="wrap-wide">
      <div class="more-head">
        <span class="eyebrow"><Bi en={t.more.eyebrow.en} ar={t.more.eyebrow.ar} /></span>
        {related.length
          ? <h2 style="margin-top:14px"><Bi en={t.more.titleRelated.en} ar={t.more.titleRelated.ar} /></h2>
          : <h2 style="margin-top:14px"><Bi en={t.more.titleAll.en} ar={t.more.titleAll.ar} /></h2>}
      </div>
      <div class="more-grid">
        {more.map((c) => (
          <a href={`/products/${c.slug}`} class="more-card">
            <span class="more-img"><img src={c.img} alt={c.name.en} loading="lazy" decoding="async" /></span>
            <span class="more-name"><Bi en={c.name.en} ar={c.name.ar} /></span>
            <span class="more-link"><Bi en={t.more.link.en} ar={t.more.link.ar} /></span>
          </a>
        ))}
        <a href="/products" class="more-card more-all">
          <span class="more-all-inner">
            <span class="more-all-count">{categories.length}</span>
            <span class="more-all-label"><Bi en={t.more.allLabel.en} ar={t.more.allLabel.ar} /></span>
            <span class="link-line"><Bi en={t.more.allCta.en} ar={t.more.allCta.ar} /></span>
          </span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs{border-bottom:1px solid var(--line-soft);background:var(--cream)}
  .crumbs > div{display:flex;align-items:center;gap:12px;padding-block:14px;font-family:var(--display);font-size:12px;letter-spacing:.14em;text-transform:uppercase}
  .crumbs a{color:var(--muted)}
  .crumbs a:hover{color:var(--gold-bright)}
  .crumbs span[aria-hidden]{color:var(--faint)}
  .crumb-here{color:var(--navy)}

  .pdp{padding-block:clamp(40px,5vw,72px) var(--section-y)}
  .pdp-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(34px,6vw,90px);align-items:start}
  .pdp-media{background:var(--cream);border:1px solid var(--line);position:sticky;top:170px}
  .pdp-media img{width:100%;aspect-ratio:4/3;object-fit:contain;padding:clamp(24px,3vw,48px);mix-blend-mode:multiply}

  /* A measurements group's photo IS the content: it is a size chart with small dimensions
     printed on it. The details column moves below so the chart gets the full page width, the
     4/3 crop and the inner padding come off so nothing is wasted, and it opens at full size.
     `height:auto` keeps the chart's own proportions instead of forcing it into a box. */
  .pdp-chart .pdp-grid{grid-template-columns:1fr;gap:clamp(26px,4vw,44px)}
  .pdp-chart .pdp-media{position:static;background:var(--cream)}
  .pdp-chart .pdp-media img{aspect-ratio:auto;height:auto;padding:clamp(10px,1.4vw,18px);mix-blend-mode:normal}
  .pdp-chart .pdp-chart-link{display:block;position:relative}
  .pdp-chart .pdp-info{max-width:74ch}
  .pdp-info h1{font-size:clamp(36px,4.6vw,62px);margin:18px 0 20px}
  .pdp-note{font-size:15px;color:var(--muted);line-height:1.7;margin-top:18px;max-width:52ch}

  .pdp-meta{display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:26px;padding-top:22px;border-top:1px solid var(--line)}
  .pdp-meta span{font-family:var(--display);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint)}

  .pdp-actions{display:flex;align-items:center;gap:28px;margin-top:30px;flex-wrap:wrap}

  /* Sections inside the group, in the house photo-and-description format: alternating rows,
     photograph on one side, number + name + description on the other. Same pattern as the
     factory departments, which is the layout the client has asked for repeatedly. The dashed
     placeholder holds the photo's shape until Printopack uploads one. */
  .range{padding-block:clamp(48px,7vw,84px);background:var(--cream);border-top:1px solid var(--line)}
  .range-list{display:flex;flex-direction:column;gap:clamp(40px,6vw,80px);margin-top:clamp(30px,4vw,52px)}
  .range-row{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(28px,5vw,64px);align-items:center}
  .range-row.reverse .range-media{order:2}
  .range-media .card-img{aspect-ratio:4/3;border-radius:var(--radius);background:var(--paper);overflow:hidden}
  .range-media .card-img img{width:100%;height:100%;object-fit:cover;display:block}
  .img-ph{display:grid;place-items:center;width:100%;height:100%;background:var(--paper);color:var(--faint);border:1px dashed var(--line)}
  .img-ph svg{width:52px;height:52px}
  .range-num{font-family:var(--display);font-size:14px;font-weight:500;letter-spacing:.2em;color:var(--gold)}
  .range-body h3{margin:12px 0 14px;font-size:clamp(22px,2.2vw,30px)}
  .range-body p{color:var(--muted);max-width:52ch}
  @media(max-width:820px){
    .range-row,.range-row.reverse{grid-template-columns:1fr;gap:22px}
    .range-row.reverse .range-media{order:0}
  }

  /* Size charts. Deliberately NOT the alternating row: a chart is technical drawing with
     small dimensions printed on it, so it runs the full width, is shown whole rather than
     cropped, and opens at full size. */
  .chart{border:1px solid var(--line);background:var(--paper);border-radius:var(--radius);overflow:hidden}
  .chart-head{padding:clamp(22px,3vw,34px) clamp(22px,3vw,38px) 0;max-width:70ch}
  .chart-tag{display:inline-block;font-family:var(--display);font-size:11px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);border:1px solid var(--line);border-radius:999px;padding:5px 12px}
  .chart-head h3{margin:14px 0 12px;font-size:clamp(23px,2.4vw,32px)}
  .chart-head p{color:var(--muted);font-size:15px;line-height:1.65}
  .chart-figure{display:block;position:relative;margin:clamp(20px,3vw,30px);background:var(--cream);border:1px solid var(--line-soft);border-radius:6px;padding:clamp(12px,2vw,22px)}
  .chart-figure img{display:block;width:100%;height:auto;max-height:none;object-fit:contain}
  .chart-zoom{position:absolute;inset-inline-end:14px;inset-block-end:14px;font-family:var(--display);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--paper);background:rgba(0,70,162,.86);padding:7px 13px;border-radius:999px}
  .chart-figure:hover .chart-zoom{background:var(--gold)}
  .chart-figure.is-empty{display:grid;place-items:center;gap:14px;min-height:clamp(220px,26vw,320px);border-style:dashed;color:var(--faint)}
  .chart-ph svg{width:58px;height:58px}
  .chart-pending{font-size:14px;color:var(--muted);max-width:44ch;text-align:center}

  .pdp-standard{padding-block:clamp(56px,7vw,96px)}
  .std-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(26px,4vw,52px);margin-top:clamp(26px,3vw,40px)}
  .std-item{border-top:1px solid var(--line-dark);padding-top:22px}
  .std-item h3{font-size:clamp(19px,1.8vw,24px);color:var(--paper);margin-bottom:10px}
  .std-item p{font-size:14.5px;color:rgba(250,246,238,.72);line-height:1.65}

  .pdp-more{border-top:1px solid var(--line-soft)}
  .more-head{margin-bottom:clamp(28px,4vw,44px)}
  .more-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(18px,2vw,30px)}
  .more-card{display:flex;flex-direction:column;border:1px solid var(--line);background:var(--paper)}
  .more-card:hover{border-color:var(--gold-bright);box-shadow:0 20px 38px rgba(0,70,162,.07)}
  .more-img{display:block;aspect-ratio:4/3;background:var(--cream);overflow:hidden}
  .more-img img{width:100%;height:100%;object-fit:contain;padding:18px;mix-blend-mode:multiply}
  .more-name{font-family:var(--display);font-size:17px;padding:16px 18px 4px;color:var(--ink)}
  .more-link{font-family:var(--display);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);padding:0 18px 18px}
  .more-card:hover .more-link{color:var(--gold-bright)}
  .more-all{align-items:center;justify-content:center;background:var(--cream);text-align:center}
  .more-all-inner{display:flex;flex-direction:column;align-items:center;gap:6px;padding:24px}
  .more-all-count{font-family:var(--display);font-size:clamp(38px,4vw,54px);font-weight:300;color:var(--navy);line-height:1}
  .more-all-label{font-family:var(--display);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}

  @media(max-width:920px){
    .pdp-grid{grid-template-columns:1fr;gap:30px}
    .pdp-media{position:static}
    .std-grid{grid-template-columns:1fr;gap:0}
    .std-item{padding-block:22px}
    .more-grid{grid-template-columns:repeat(2,1fr)}
  }
  @media(max-width:520px){
    .more-grid{grid-template-columns:1fr}
  }
</style>
