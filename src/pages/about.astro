---
import Base from '../layouts/Base.astro';
import Bi from '../components/Bi.astro';

// ── EDITABLE CONTENT (bilingual) ─────────────────────────────────────────────
// About Us is a concise hub routing into the four subpages. Arabic uses Nasser's own
// section names (الشركة، المسؤولية الاجتماعية، أقسام المصنع، فريق العمل).
const content = {
  meta: {
    title: "About Us - Printopack",
    description: "Get to know Printopack: the company, our social responsibility, our factory departments and our team.",
  },
  header: {
    eyebrow: { en: "About us", ar: "من نحن" },
    title: { en: "About Printopack.", ar: "عن برنتوباك." },
    lede: {
      en: "Get to know the company behind the packaging, our responsibility, our plant and our people. Choose a section to explore.",
      ar: "تعرّف على الشركة التي تقف وراء التغليف، ومسؤوليتنا، ومصنعنا، وفريقنا. اختر قسماً لاستكشافه.",
    },
  },
  go: { en: "Explore", ar: "استكشف" },
  subpages: [
    { title: { en: "The Company", ar: "الشركة" }, desc: { en: "History, ownership, mission, vision and values.", ar: "التاريخ والملكية والرسالة والرؤية والقيم." }, href: "/company", img: "/images/sub-company.webp" },
    { title: { en: "Factory Departments", ar: "أقسام المصنع" }, desc: { en: "Inside the plant: printing, engraving, converting and more.", ar: "داخل المصنع: الطباعة والحفر والتحويل والمزيد." }, href: "/factory", img: "/images/sub-factory.webp" },
    { title: { en: "Our Team", ar: "فريق العمل" }, desc: { en: "The people who run the press floor and the offices.", ar: "الأشخاص الذين يديرون أرضية المصنع والمكاتب." }, href: "/team", img: "/images/sub-team.webp" },
    { title: { en: "Social Responsibility", ar: "المسؤولية الاجتماعية" }, desc: { en: "Environment, local community and international commitments.", ar: "البيئة والمجتمع المحلي والالتزامات الدولية." }, href: "/responsibility", img: "/images/sub-responsibility.webp" },
  ],
};
const c = content;
---
<Base title={c.meta.title} description={c.meta.description}>
  <!-- PAGE HEADER -->
  <section class="page-head">
    <div class="wrap-wide">
      <div class="page-head-inner">
        <span class="eyebrow"><Bi en={c.header.eyebrow.en} ar={c.header.eyebrow.ar} /></span>
        <h1><Bi en={c.header.title.en} ar={c.header.title.ar} /></h1>
        <p class="lede"><Bi en={c.header.lede.en} ar={c.header.lede.ar} /></p>
      </div>
    </div>
  </section>

  <!-- SUBPAGE CARDS -->
  <section class="sub">
    <div class="wrap-wide">
      <div class="sub-grid">
        {c.subpages.map((s) => (
          <a class="sub-card" href={s.href}>
            <span class="sub-media"><img src={s.img} alt={s.title.en} loading="lazy" decoding="async" /></span>
            <span class="sub-scrim"></span>
            <span class="sub-body">
              <span class="sub-title"><Bi en={s.title.en} ar={s.title.ar} /></span>
              <span class="sub-desc"><Bi en={s.desc.en} ar={s.desc.ar} /></span>
              <span class="sub-go"><Bi en={c.go.en} ar={c.go.ar} /> &rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Tighter throughout: the client finds the page over-airy. The head loses about a third
     off the top, and the section below it takes half the global rhythm rather than all of it. */
  .page-head{padding-block:clamp(40px,5.2vw,68px) clamp(22px,2.6vw,34px);background:var(--cream);border-bottom:1px solid var(--line)}
  .sub{padding-block:clamp(38px,4.6vw,64px)}
  .page-head-inner{max-width:820px}
  .page-head h1{margin:20px 0 22px;font-size:clamp(40px,6vw,78px)}
  .page-head .lede{max-width:60ch}

  .sub-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}
  /* Same construction as the seven cards on the home page: the photograph fills the card and
     the words sit on it over a scrim, rather than in a panel underneath. Shorter than the old
     image-plus-panel stack, which is what made these boxes tall. */
  .sub-card{position:relative;display:block;height:clamp(240px,22vw,300px);border-radius:var(--radius);overflow:hidden;background:var(--navy-deep);border:1px solid var(--line)}
  .sub-media{position:absolute;inset:0}
  .sub-media img{width:100%;height:100%;object-fit:cover;filter:brightness(.86) saturate(1.08)}
  .sub-card:hover .sub-media img{filter:brightness(1) saturate(1.12)}
  .sub-scrim{position:absolute;inset:0;background:linear-gradient(0deg,rgba(9,24,41,.95) 0%,rgba(9,24,41,.86) 30%,rgba(9,24,41,.62) 50%,rgba(9,24,41,.3) 68%,transparent 88%)}
  .sub-body{position:absolute;inset:auto 0 0 0;z-index:2;display:flex;flex-direction:column;padding:clamp(20px,2vw,26px);color:var(--paper)}
  .sub-title{font-family:var(--display);font-size:clamp(20px,1.9vw,25px);font-weight:var(--w-light);color:var(--paper);line-height:1.1}
  .sub-desc{color:#fff;font-size:14px;line-height:1.5;margin:8px 0 12px;max-width:34ch}
  .sub-go{font-family:var(--display);font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-on-dark)}
  .sub-card::after{content:"";position:absolute;inset:0;z-index:3;border:2px solid transparent;border-radius:var(--radius)}
  .sub-card:hover::after{border-color:var(--gold-bright)}
  [dir="rtl"] .sub-go{direction:rtl}
  @media(max-width:640px){.sub-grid{grid-template-columns:1fr}}
</style>
