  .oc-note{margin-top:8px;font-size:12.5px;color:var(--navy)}

  /* form */
  .enquire-formwrap{margin-top:clamp(22px,3vw,32px);background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:clamp(24px,3vw,38px)}
  .enquire-success{background:var(--gold-soft);border:1px solid var(--gold);color:var(--navy);padding:16px 18px;border-radius:var(--radius);font-size:15px}
  .enquire-form{display:flex;flex-direction:column;gap:16px}
  .field{display:flex;flex-direction:column;gap:7px}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .field-label{font-family:var(--display);font-size:12px;font-weight:500;letter-spacing:.06em;color:var(--muted)}
  .lock-label{display:flex;align-items:center;gap:8px}
  .auto-tag{font-family:var(--display);font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);background:var(--gold-soft);border:1px solid var(--gold);border-radius:999px;padding:2px 8px}
  .enquire-form input,.enquire-form textarea,.enquire-form select{
    font-family:var(--body);font-size:15px;color:var(--ink);background:var(--white);
    border:1px solid var(--line);border-radius:var(--radius);padding:12px 14px;width:100%;
  }
  .enquire-form input:focus,.enquire-form textarea:focus,.enquire-form select:focus{outline:none;border-color:var(--navy)}
  .enquire-form textarea{resize:vertical;min-height:96px}
  .select-wrap{position:relative;display:block}
  .enquire-form select,.map-pick select{
    font-family:var(--body);font-size:15px;color:var(--ink);background:var(--white);
    border:1px solid var(--line);border-radius:var(--radius);padding:12px 14px;width:100%;
    appearance:none;-webkit-appearance:none;padding-inline-end:40px;cursor:pointer;
  }
  .enquire-form select:focus,.map-pick select:focus{outline:none;border-color:var(--navy)}

  /* Form feedback. An enquiry that fails has to say so where the person is looking, in the
     colour the site uses for a problem, and it must not look like the success panel. */
  .form-error{margin:4px 0 0;padding:12px 14px;border:1px solid var(--red,#a60006);border-radius:var(--radius);
    background:color-mix(in srgb, var(--red,#a60006) 7%, transparent);color:var(--red,#a60006);font-size:14px;line-height:1.5}
  .form-note{display:block;margin-top:8px;font-size:13.5px;opacity:.85}
  .enquire-form select:disabled,.map-pick select:disabled{background:var(--surface);color:var(--faint);cursor:not-allowed}
  .select-chevron{position:absolute;inset-inline-end:14px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:var(--muted);pointer-events:none}
  /* locked, auto-filled office fields: clearly outlined + visibly unchangeable */
  .locked-row .field{gap:7px}
  .enquire-form input.locked{
    background:var(--cream);border:1.5px dashed var(--gold);color:var(--navy);
    font-family:var(--display);font-weight:500;cursor:not-allowed;
  }
  .enquire-form input.locked:focus{outline:none;border-color:var(--gold)}

  /* career-only fields + modern upload dropzones */
  .career-fields{display:flex;flex-direction:column;gap:16px;border-top:1px solid var(--line);padding-top:18px;margin-top:2px}
  .career-fields[hidden]{display:none}
  .career-note{background:var(--gold-soft);border:1px solid var(--gold);color:var(--navy);padding:12px 14px;border-radius:var(--radius);font-size:13.5px}
  .file-drop{position:relative;display:flex;align-items:center;gap:14px;border:1.5px dashed var(--line);border-radius:var(--radius);padding:15px 18px;background:var(--white);cursor:pointer}
  .file-drop:hover{border-color:var(--gold-bright);background:var(--surface)}
  .file-native{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
  .file-icon{flex:none;display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--surface);color:var(--navy)}
  .file-icon svg{width:20px;height:20px}
  .file-drop:hover .file-icon{background:var(--paper)}
  .file-copy{display:flex;flex-direction:column;gap:2px;min-width:0}
  .file-cta{font-family:var(--display);font-size:14.5px;color:var(--navy);line-height:1.3;word-break:break-word}
  .file-hint{font-size:12px;color:var(--muted)}
  .file-drop.has-file{border-style:solid;border-color:var(--gold);background:var(--gold-soft)}
  .file-drop.has-file .file-icon{background:var(--gold);color:var(--paper)}
  .file-drop.has-file .file-cta{color:var(--ink)}

  .enquire-submit{justify-content:center;margin-top:6px}

  /* open-in-email-app row */
  .compose{margin-top:4px;padding-top:18px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:12px}
  .compose-label{font-family:var(--display);font-size:12px;font-weight:500;letter-spacing:.06em;color:var(--muted)}
  .compose-btns{display:flex;flex-wrap:wrap;gap:10px}
  .compose-btn{display:inline-flex;align-items:center;gap:9px;border:1px solid var(--line);border-radius:var(--radius);padding:10px 16px;font-family:var(--display);font-size:13.5px;color:var(--navy);background:var(--white);cursor:pointer}
  .compose-btn svg{width:17px;height:17px;color:var(--gold)}
  .compose-btn:hover{border-color:var(--gold-bright);background:var(--surface)}

  /* offices directory */
  .offices-band{padding-block:clamp(56px,7vw,96px)}
  .office-group-label{display:block;font-family:var(--display);font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-bright);margin:clamp(24px,3vw,36px) 0 18px}
  .office-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,2.6vw,34px)}
  /* Office details on the left, the manager's square photo filling the space on the right. */
  .office{border-top:1px solid var(--line-dark);padding-top:18px;display:flex;align-items:flex-start;justify-content:space-between;gap:18px}
  .office-info{display:flex;flex-direction:column;gap:5px;min-width:0}
  .office h3{font-size:clamp(18px,1.7vw,23px);color:var(--paper);margin-bottom:2px}
  .office-area{font-family:var(--display);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(250,246,238,.5)}
  .office-staff{display:flex;flex-direction:column;gap:1px;margin-bottom:6px;min-width:0}
  /* Square, not a circle: it sits in the block of empty space beside the details, and its
     side is driven by the text column so the two line up top and bottom. */
  .staff-photo{flex:none;width:clamp(84px,7vw,104px);aspect-ratio:1;border-radius:4px;overflow:hidden;display:grid;place-items:center;background:rgba(250,246,238,.09);border:1px solid rgba(250,246,238,.16)}
  .staff-photo img{width:100%;height:100%;object-fit:cover;display:block}
  .staff-mono{font-family:var(--display);font-size:26px;font-weight:300;letter-spacing:.06em;color:rgba(250,246,238,.5)}
  .staff-role{font-family:var(--display);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:rgba(250,246,238,.5)}
  .staff-name{font-size:15px;color:var(--gold-bright)}
  .office a{font-size:14px;color:rgba(250,246,238,.72)}
  .office a:hover{color:var(--gold-bright)}

  @media(max-width:960px){.office-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:900px){
    .chan-grid{grid-template-columns:1fr;gap:30px}
  }
  @media(max-width:560px){
    .field-row{grid-template-columns:1fr}
    .office-grid{grid-template-columns:1fr}
    .compose-btn{flex:1 1 auto;justify-content:center}
    /* Direct lines: on a phone these addresses and that number are the point of the page,
       and they were 26px rows. Each becomes a 44px row so a thumb lands on the right one. */
    .chan-list a{min-height:44px;display:flex;align-items:center}
    /* The square photo fills empty space beside the details on a desktop. A phone has no
       empty space: it squeezed the text to 191px and broke every address across two lines
       ("yemen@printopack.com.sa" over two). The photo moves above the details, which is the
       usual shape for a person card on a phone, and the details take the full width. */
    .office{flex-direction:column;align-items:stretch;gap:14px}
    .staff-photo{order:-1;width:72px}
    /* Phone and email are what a visitor actually came here to tap, and on a phone the
       phone number IS the call. They were 25px lines packed two to a card, so each gets a
       44px row of its own with a hairline between them, which also stops a mis-tap dialling
       the wrong office. */
    .office-info a{min-height:44px;display:flex;align-items:center;font-size:15px}
    .office-info a + a{border-top:1px solid rgba(255,255,255,.10)}
  }
</style>

<script define:vars={{ OFFICES: officesByCc, HR: hrOffice, NOTE: { en: c.enquire.officeNote.en, ar: c.enquire.officeNote.ar }, CAREER: { en: c.enquire.careerNote.en, ar: c.enquire.careerNote.ar } }}>
  // Enquiry window logic:
  //  - reason + market drive the "autonomous mapper": a resolved recipient (office email +
  //    phone) and a subject are written into the read-only fields + hidden fields on every
  //    change. Careers is handled centrally by HR: it swaps the locked contact to HR,
  //    disables the market picker + dims the map, and reveals the CV / cover-letter uploads.
  //  - the market pull-down (beside the map) and the map are two-way synced.
  //  - the compose buttons open a pre-filled draft (recipient + subject + body) in the
  //    visitor's Outlook / Gmail / default mail app.
  //  - ?office=<cc> (Partners popup) and ?reason=/&role= (legacy Careers) preselect + scroll.
  const scope = document.getElementById('enquire');
  const form = scope && scope.querySelector('.enquire-form');
  if (scope && form) {
    const reasonSel = form.querySelector('.reason-select');
    const marketSel = scope.querySelector('.market-select');
    const mapPick = document.getElementById('map-pick');
    const fRoute = form.querySelector('.f-route');
    const fOPhone = form.querySelector('.f-ophone');
    const fDept = form.querySelector('.f-dept');
    const fMarket = form.querySelector('.f-market');
    const fSubject = form.querySelector('.f-subject');
    const mapWrap = document.getElementById('mapwrap');
    const card = document.getElementById('office-card');
    const ocRole = card.querySelector('.oc-role');
    const ocName = card.querySelector('.oc-name');
    const ocPlace = card.querySelector('.oc-place');
    const ocNote = card.querySelector('.oc-note');
    const ocPhoto = card.querySelector('.oc-photo');
    const careerFields = form.querySelector('.career-fields');
    const cvInput = form.querySelector('.cv-input');
    const paths = Array.from(scope.querySelectorAll('.rc'));
    const lang = () => (document.documentElement.dir === 'rtl' ? 'ar' : 'en');
    const isCareers = () => reasonSel.value === 'careers';
    const currentOffice = () => (isCareers() ? HR : OFFICES[marketSel.value] || OFFICES.sa);

    const highlight = () => {
      const cc = marketSel.value;
      paths.forEach((p) => p.classList.toggle('active', !isCareers() && p.dataset.cc === cc));
    };
    const renderCard = () => {
      const o = currentOffice(); const L = lang();
      ocRole.textContent = o.role[L];
      ocName.textContent = o.name[L];
      ocPlace.textContent = (o.place && o.place[L]) ? o.place[L] : '';
      ocNote.textContent = isCareers() ? CAREER[L] : NOTE[L];
      const pic = o.photo || '';
      ocPhoto.innerHTML = '';
      if (pic) {
        const img = document.createElement('img');
        img.src = pic; img.alt = ''; img.loading = 'lazy'; img.decoding = 'async';
        ocPhoto.appendChild(img);
      } else {
        const sp = document.createElement('span');
        sp.className = 'oc-mono';
        sp.textContent = o.mono || '';
        ocPhoto.appendChild(sp);
      }
    };
    const sync = () => {
      const o = currentOffice();
      const r = reasonSel.selectedOptions[0];
      const m = marketSel.selectedOptions[0];
      fRoute.value = o.email;
      fOPhone.value = o.phone;
      fDept.value = r.dataset.en;
      fMarket.value = isCareers() ? '' : marketSel.value;
      fSubject.value = 'Website enquiry: ' + r.dataset.en + (!isCareers() && m ? ' (' + m.dataset.en + ')' : '');
    };
    const applyMode = () => {
      const careers = isCareers();
      careerFields.hidden = !careers;
      if (careers) cvInput.setAttribute('required', ''); else cvInput.removeAttribute('required');
      marketSel.disabled = careers;
      mapPick.classList.toggle('is-disabled', careers);
      mapWrap.classList.toggle('is-locked', careers);
    };
    const refresh = () => { applyMode(); highlight(); renderCard(); sync(); };

    reasonSel.addEventListener('change', refresh);
    marketSel.addEventListener('change', refresh);
    const pickMarket = (cc) => {
      if (isCareers()) return;
      const opt = Array.from(marketSel.options).find((o) => o.value === cc);
      if (opt) { marketSel.value = cc; refresh(); }
    };
    const bind = (el) => {
      el.addEventListener('click', (e) => { e.stopPropagation(); pickMarket(el.dataset.cc); });
      el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pickMarket(el.dataset.cc); } });
    };
    paths.forEach(bind);

    // modern upload dropzones: reflect the chosen filename
    scope.querySelectorAll('[data-file]').forEach((drop) => {
      const input = drop.querySelector('.file-native');
      const cta = drop.querySelector('.file-cta');
      const base = cta.textContent;
      input.addEventListener('change', () => {
        if (input.files && input.files.length) { cta.textContent = input.files[0].name; drop.classList.add('has-file'); }
        else { cta.textContent = base; drop.classList.remove('has-file'); }
      });
    });

    // open a pre-filled draft in the visitor's chosen mail app
    const val = (n) => (form.querySelector('[name="' + n + '"]')?.value || '').trim();
    const buildBody = () => {
      const m = marketSel.selectedOptions[0];
      const lines = ['Reason: ' + fDept.value];
      if (!isCareers() && m) lines.push('Market: ' + m.dataset.en);
      lines.push('Name: ' + val('name'), 'Email: ' + val('email'));
      if (val('phone')) lines.push('Phone: ' + val('phone'));
      if (val('company')) lines.push('Company: ' + val('company'));
      lines.push('', val('message'));
      return lines.join('\r\n');
    };
    scope.querySelectorAll('[data-compose]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const to = fRoute.value, su = fSubject.value, body = buildBody();
        const eS = encodeURIComponent(su), eB = encodeURIComponent(body), eT = encodeURIComponent(to);
        const kind = btn.dataset.compose;
        if (kind === 'gmail') {
          window.open('https://mail.google.com/mail/?view=cm&fs=1&to=' + eT + '&su=' + eS + '&body=' + eB, '_blank', 'noopener');
        } else if (kind === 'outlook') {
          window.open('https://outlook.office.com/mail/deeplink/compose?to=' + eT + '&subject=' + eS + '&body=' + eB, '_blank', 'noopener');
        } else {
          window.location.href = 'mailto:' + to + '?subject=' + eS + '&body=' + eB;
        }
      });
    });

    // bilingual <option> labels (both selects live under #enquire)
    const swapOptions = () => {
      const L = lang();
      scope.querySelectorAll('option[data-en]').forEach((o) => { o.textContent = L === 'ar' ? o.dataset.ar : o.dataset.en; });
    };
    new MutationObserver(() => { swapOptions(); renderCard(); sync(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['dir', 'lang'] });
    swapOptions();

    // preselect from query params
    const qs = new URLSearchParams(location.search);
    const office = qs.get('office');
    const reason = qs.get('reason');
    const role = qs.get('role');
    const reasonMap = { general: 'general', quote: 'sales', sales: 'sales', marketing: 'marketing', careers: 'careers' };
    if (reason && reasonMap[reason]) reasonSel.value = reasonMap[reason];
    if (office && OFFICES[office] && reasonSel.value !== 'careers') marketSel.value = office;
    if (role) {
      const msg = form.querySelector('textarea[name="message"]');
      if (msg && !msg.value) msg.value = 'Regarding the "' + role + '" role.';
    }
    refresh();
    if (office || reason) {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      requestAnimationFrame(() => scope.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' }));
    }

    // Send the enquiry without leaving the page, so the visitor keeps everything they typed
    // if anything goes wrong. The success panel replaces the form only once the server has
    // actually confirmed it: telling someone their enquiry arrived when it did not is worse
    // than making them press the button again.
    const okPanel = scope.querySelector('.enquire-success');
    const submitBtn = form.querySelector('button[type="submit"]');
    let sending = false;
    let errBox = form.querySelector('.form-error');
    if (!errBox) {
      errBox = document.createElement('p');
      errBox.className = 'form-error';
      errBox.setAttribute('role', 'alert');
      errBox.hidden = true;
      form.insertBefore(errBox, submitBtn);
    }
    const showError = (msg) => { errBox.textContent = msg; errBox.hidden = false; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      const langNow = document.documentElement.getAttribute('dir') === 'rtl' ? 'ar' : 'en';
      const langField = form.querySelector('.f-lang');
      if (langField) langField.value = langNow;
      errBox.hidden = true;
      sending = true;
      const label = submitBtn ? submitBtn.innerHTML : '';
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = langNow === 'ar' ? 'جارٍ الإرسال…' : 'Sending…'; }
      try {
        const res = await fetch('/api/enquiry', { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || '');
        if (okPanel) {
          okPanel.hidden = false;
          if (data.rejected && data.rejected.length) {
            const extra = document.createElement('span');
            extra.className = 'form-note';
            extra.textContent = (langNow === 'ar'
              ? 'لم نتمكّن من إرفاق: '
              : 'We could not attach: ') + data.rejected.join(', ') + '.';
            okPanel.appendChild(extra);
          }
        }
        form.hidden = true;
        okPanel?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
      } catch (err) {
        showError(err.message || (langNow === 'ar'
          ? 'تعذّر إرسال رسالتك. يرجى المحاولة مرة أخرى، أو مراسلتنا مباشرة على info@printopack.com.sa'
          : 'Your message could not be sent. Please try again, or email us directly at info@printopack.com.sa'));
      } finally {
        sending = false;
        if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = label; }
      }
    });
  }
</script>
