  .oc-role{font-family:var(--display);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin-top:4px}
  .oc-name{font-family:var(--display);font-size:20px;color:var(--ink);line-height:1.15}
  .oc-place{font-size:13.5px;color:var(--muted)}
