---
// The admin dashboard route. The dashboard itself is the standalone vanilla app in
// /public/admin/ (admin.js + admin.css); this page is only its HTML shell, kept here
// rather than as public/admin/index.html so that `astro dev` serves /admin/ too (the
// dev server does not resolve a directory index inside public/).
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Printopack System · Admin</title>
<meta name="robots" content="noindex">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Inter:wght@300;400;500;600&family=IBM+Plex+Sans+Arabic:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/admin/admin.css">
</head>
<body>
<div id="root"></div>
<div class="toast" id="toast"><span id="toastText"></span></div>
<script src="/admin/admin.js" is:inline></script>
</body>
</html>
