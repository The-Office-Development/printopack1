---
import Bi from './Bi.astro';

// Site-wide accessibility controls, required for Saudi websites. A round launcher button carrying
// the universal accessibility symbol (the figure the client asked for, the one recognised for this
// purpose) sits fixed on every page; pressing it opens a small panel with two controls: an
// "increase text size" button and a "colorless" (grayscale) button, for visitors with visual
// difficulty. Rendered once per page from Base.astro, so the same control sits on every page.
//
// Text size is a UNIFORM zoom on the document root (see the script), not a per-element font tweak:
// the site is px-based across dozens of components, and a uniform zoom enlarges the whole page the
// way the browser's own zoom does, so nothing overflows or overlaps at any level. Colorless is a
// grayscale filter on the ROOT element specifically (global.css), the one element where a filter
// does not trap position:fixed, so the sticky header, the QR overlay and this control keep working.
//
// Both choices persist in localStorage and are re-applied before paint by the inline script in
// Base.astro's <head>, so there is no flash on navigation. No motion, in keeping with the site.
---
<div class="a11y" data-open="false">
  <div class="a11y-panel" id="a11y-panel" role="group" aria-label="Accessibility options">
    <button class="a11y-btn" id="a11y-font" type="button" aria-label="Increase text size">
      <span class="a11y-ico a11y-ico-txt" aria-hidden="true"><span class="sm">A</span><span class="lg">A</span></span>
      <span class="a11y-lbl"><Bi en="Text size" ar="حجم الخط" /></span>
      <span class="a11y-pips" aria-hidden="true"><i></i><i></i></span>
    </button>
    <button class="a11y-btn" id="a11y-gray" type="button" aria-pressed="false" aria-label="Toggle colorless mode">
      <span class="a11y-ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6" />
          <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" />
        </svg>
      </span>
      <span class="a11y-lbl"><Bi en="Colorless" ar="بلا ألوان" /></span>
    </button>
  </div>
  <button class="a11y-toggle" id="a11y-toggle" type="button" aria-expanded="false" aria-controls="a11y-panel" aria-label="Accessibility options">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M12 2c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2zm9 7h-6v13h-2v-6h-2v6H9V9H3V7h18v2z" />
    </svg>
  </button>
  <span id="a11y-live" class="a11y-sr" aria-live="polite"></span>
</div>

<style>
  .a11y{
    position:fixed;
    inset-block-end:18px;
    inset-inline-start:18px;
    z-index:90;
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    gap:10px;
  }
  /* The launcher: a round button carrying the universal accessibility symbol, in the exact
     Printopack logo blue (also the internationally recognised colour for this control). */
  .a11y-toggle{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:52px;
    height:52px;
    border:0;
    border-radius:50%;
    background:var(--blue);
    color:var(--white);
    box-shadow:0 10px 30px rgba(0,70,162,.32);
    cursor:pointer;
  }
  .a11y-toggle svg{width:28px;height:28px}
  .a11y-toggle:hover{background:var(--navy-deep)}
  .a11y-toggle:focus-visible{outline:2px solid var(--gold);outline-offset:3px}

  /* The panel holds the two controls; it is closed by default and opens above the launcher. */
  .a11y-panel{
    display:none;
    gap:8px;
    padding:7px;
    background:var(--white);
    border:1px solid var(--line);
    border-radius:calc(var(--radius) + 8px);
    box-shadow:0 10px 30px rgba(0,70,162,.16);
  }
  .a11y[data-open="true"] .a11y-panel{display:flex}

  .a11y-btn{
    display:inline-flex;
    align-items:center;
    gap:9px;
    min-height:44px;
    padding:0 13px;
    border:1px solid var(--line);
    border-radius:var(--radius);
    background:var(--white);
    color:var(--navy);
    font-family:var(--display);
    font-size:12.5px;
    font-weight:600;
    letter-spacing:.03em;
    cursor:pointer;
  }
  .a11y-btn:hover{background:var(--navy);color:var(--white);border-color:var(--navy)}
  .a11y-btn:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
  .a11y-btn.is-active,.a11y-btn[aria-pressed="true"]{background:var(--navy);color:var(--white);border-color:var(--navy)}
  .a11y-ico{display:inline-flex;align-items:center;justify-content:center;flex:none}
  .a11y-ico svg{width:19px;height:19px}
  .a11y-ico-txt{gap:1px;line-height:1;font-weight:800}
  .a11y-ico-txt .sm{font-size:11px}
  .a11y-ico-txt .lg{font-size:18px}
  .a11y-lbl{white-space:nowrap}
  /* Two pips that fill with the current text-size level, so the button shows how large it is set. */
  .a11y-pips{display:inline-flex;gap:3px;flex:none}
  .a11y-pips i{width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.28}
  #a11y-font[data-level="1"] .a11y-pips i:nth-child(1),
  #a11y-font[data-level="2"] .a11y-pips i{opacity:1}
  /* Screen-reader-only live region for announcing the new size. */
  .a11y-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;padding:0;margin:-1px}

  /* On small screens the labels fold away to keep the panel out of the content; the icons and
     the aria-labels stay, so it is still a two-button control that a screen reader can name. */
  @media(max-width:600px){
    .a11y{inset-block-end:12px;inset-inline-start:12px;gap:8px}
    .a11y-toggle{width:48px;height:48px}
    .a11y-toggle svg{width:26px;height:26px}
    .a11y-panel{gap:6px;padding:6px}
    .a11y-btn{padding:0 11px;gap:7px}
    .a11y-lbl,.a11y-pips{display:none}
  }
</style>

<script>
  const html = document.documentElement;
  const ZOOM = ['', '1.15', '1.3'];              // 100% / 115% / 130%
  const PCT  = ['100%', '115%', '130%'];
  const wrap = document.querySelector('.a11y') as HTMLElement | null;
  const toggle = document.getElementById('a11y-toggle');
  const fontBtn = document.getElementById('a11y-font');
  const grayBtn = document.getElementById('a11y-gray');
  const live = document.getElementById('a11y-live');

  const readInt = (k: string) => { try { return parseInt(localStorage.getItem(k) || '0', 10) || 0; } catch { return 0; } };
  const save = (k: string, v: number) => { try { localStorage.setItem(k, String(v)); } catch {} };

  let level = Math.min(2, Math.max(0, readInt('a11yFont')));
  let gray = readInt('a11yGray') === 1;

  function applyFont() {
    (html.style as any).zoom = ZOOM[level];
    fontBtn?.setAttribute('data-level', String(level));
    fontBtn?.classList.toggle('is-active', level > 0);
  }
  function applyGray() {
    html.classList.toggle('a11y-grayscale', gray);
    grayBtn?.setAttribute('aria-pressed', String(gray));
  }

  // The pre-paint script in <head> already set both; re-sync the button state here.
  applyFont();
  applyGray();

  // Open/close the panel from the launcher; close on outside click or Escape.
  function setOpen(open: boolean) {
    if (!wrap) return;
    wrap.dataset.open = String(open);
    toggle?.setAttribute('aria-expanded', String(open));
  }
  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(wrap?.dataset.open !== 'true');
  });
  document.addEventListener('click', (e) => {
    if (wrap?.dataset.open === 'true' && !wrap.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  fontBtn?.addEventListener('click', () => {
    level = (level + 1) % 3;
    save('a11yFont', level);
    applyFont();
    if (live) live.textContent = 'Text size ' + PCT[level];
  });

  grayBtn?.addEventListener('click', () => {
    gray = !gray;
    save('a11yGray', gray ? 1 : 0);
    applyGray();
  });
</script>
