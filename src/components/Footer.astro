---
import Bi from './Bi.astro';
import { collection, singleton, stats } from '../lib/content';
// Global footer: newsletter band + deep navy footer with columns, QR, offices, legal.
// Company details come from the editable `settings` record and the regional offices
// from the offices collection, so the client changes an address, a phone or an office
// once in the admin and the footer of every page follows.
const year = new Date().getFullYear();
const s = singleton('settings');
// Trailing full stop trimmed so the copyright line never reads "Co. Ltd.. All rights reserved."
const stop = (t: string) => String(t || '').trim().replace(/\.$/, '');
const company = stop(s.company) || 'Printopack - Saudi Modern Packaging Factory Co. Ltd';
const phone = s.phone || '+966 12 608 1074';
// Optional second number; the footer simply omits the line when it is blank.
const phone2 = s.phone2 || '';
const email = s.email || 'info@printopack.com.sa';
const address = { en: s.address || '', ar: s.addressAr || s.address || '' };
// HQ (Jeddah) is shown above as the head-office address; these are the regional sales offices.
// Sorted alphabetically here rather than by hand, so an office added in the admin lands in
// the right place on the next build with nobody reordering anything. Each language sorts in
// its own alphabet, which is why there are two lists: one order cannot satisfy both.
const _offices = collection('offices').filter((o) => o.group === 'Regional & Export');
const officesEn = _offices.map((o) => o.city).filter(Boolean)
  .sort((a, b) => String(a).localeCompare(String(b), 'en'));
const officesAr = _offices.map((o) => o.cityAr || o.city).filter(Boolean)
  .sort((a, b) => String(a).localeCompare(String(b), 'ar'));
---
<!-- Closing band: the quote CTA and the newsletter sign-up side by side. They used to be
     two stacked full-width bands, one after the other, which made the foot of the page very
     tall and said much the same thing twice. The CTA moved here from the home page, so it
     now closes every page rather than only that one. -->
<section class="close-band">
  <div class="wrap-wide close-grid">
    <div class="close-col">
      <span class="eyebrow plain"><Bi en="Let's talk packaging" ar="لنتحدّث عن التغليف" /></span>
      <h2><Bi en="Set the standard in your industry." ar="ارتقِ بمعيار التغليف في قطاعك." /></h2>
      <a href="/contact" class="btn btn-solid"><Bi en="Request a quote" ar="اطلب عرض سعر" /></a>
    </div>
    <div class="close-col close-news">
      <span class="eyebrow plain"><Bi en="Stay ahead" ar="ابقَ على اطّلاع" /></span>
      <h2><Bi en="News from Printopack" ar="أخبار برنتوباك" /></h2>
      <p class="close-lede"><Bi en="Be the first to hear about new capabilities, certifications and exhibitions." ar="كن أول من يعلم بأحدث الإمكانات والشهادات والمعارض." /></p>
      <!-- A real subscription. This form used to be onsubmit="return false" with nothing
           behind it: it accepted an address on every page of the site and threw it away.
           It now writes to the same contact book the mailing tool sends from, recorded as a
           newsletter opt-in, which is the strongest basis there is for writing to someone. -->
      <form class="news-form" method="POST" action="/api/enquiry">
        <input type="hidden" name="kind" value="newsletter" />
        <input type="hidden" name="lang" class="f-lang" value="en" />
        <p class="hp" hidden><label>Do not fill this in: <input name="bot-field" /></label></p>
        <input type="email" name="email" placeholder="Your email address" data-ph-ar="بريدك الإلكتروني" required />
        <button class="btn btn-solid" type="submit"><Bi en="Subscribe" ar="اشترك" /></button>
      </form>
      <p class="news-msg" role="status" hidden></p>
    </div>
  </div>
</section>

<footer class="site-footer on-deep">
  <div class="wrap-wide">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href="/" class="wordmark" aria-label="Printopack home"><img src="/images/printopack-lockup-footer.svg" alt="Printopack, Saudi Modern Packaging Factory Co. Ltd." width="513" height="208" /></a>
        <p><Bi en={`Flexible packaging, printed and finished in Jeddah for brands across ${stats.countries}+ countries since ${stats.founded}.`} ar={`تغليف مرن، يُطبع ويُجهّز في جدة لعلامات تجارية في أكثر من ${stats.countries} دولة منذ عام ${stats.founded}.`} /></p>
      </div>

      <!-- The QR takes the place of the two link columns the client removed. Every route in
           them is already in the header nav, so the footer was repeating itself; the code is
           the thing he wanted given room. -->
      <div class="qr">
        <button class="qr-box" data-qr-open aria-label="Enlarge the QR code">
          <img src="/images/printopack-qr.png" alt="Printopack QR code" width="451" height="451" />
        </button>
        <span><Bi en="Scan for our digital profile" ar="امسح للوصول إلى ملفنا الرقمي" /></span>
      </div>

      <div class="foot-col foot-visit">
        <p><Bi en={address.en} ar={address.ar} /></p>
        <a href={`mailto:${email}`}>{email}</a>
        <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} dir="ltr">{phone}</a>
        {phone2 && <a href={`tel:${phone2.replace(/[^+\d]/g, '')}`} dir="ltr">{phone2}</a>}
        <div class="offices">
          <span class="offices-label"><Bi en="Regional offices" ar="المكاتب الإقليمية" /></span>
          <div class="offices-list i18n-en">{officesEn.map((o) => <span>{o}</span>)}</div>
          <div class="offices-list i18n-ar" lang="ar">{officesAr.map((o) => <span>{o}</span>)}</div>
        </div>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {year} <Bi en={`${company}. All rights reserved.`} ar={`${stop(s.companyAr) || company}. جميع الحقوق محفوظة.`} /></span>
      <div class="foot-legal">
        <a href="/privacy"><Bi en="Privacy" ar="الخصوصية" /></a>
        <a href="/conditions"><Bi en="Conditions" ar="الشروط" /></a>
        <a href="https://www.linkedin.com/company/80331793/" target="_blank" rel="noopener">LinkedIn</a>
        <a href="#" target="_blank" rel="noopener">Facebook</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Light, so it reads as its own band above the blue footer rather than merging into it.
     This echoes the grey the home page opens on, but is set independently of it. */
  .close-band{background:#ececec;color:var(--ink);padding-block:var(--band-y);border-top:1px solid var(--line)}
  .close-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,4.5vw,64px);align-items:start}
  /* the rule divides the two halves and follows reading order, so it sits on the correct
     side once the page flips to Arabic */
  .close-news{border-inline-start:1px solid var(--line);padding-inline-start:clamp(30px,4.5vw,64px)}
  .close-col .eyebrow{color:var(--gold)}
  .close-col .eyebrow::before{background:var(--gold)}
  .close-col h2{margin:14px 0 22px;max-width:18ch;color:var(--blue)}
  .close-lede{color:var(--muted);max-width:42ch;margin:0 0 24px;font-size:15.5px;line-height:1.6}
  .hp{position:absolute;left:-9999px}
  .news-msg{margin-top:12px;font-size:13.5px;color:#fff;max-width:460px}
  .news-msg.err{color:var(--gold-bright)}
  .news-form{display:flex;gap:10px;max-width:460px}
  .news-form input{flex:1;min-width:0;padding:15px 18px;border:1px solid var(--line);background:var(--white);font:inherit;font-size:15px;border-radius:var(--radius)}
  .news-form input:focus{outline:none;border-color:var(--blue)}
  @media(max-width:820px){
    .close-grid{grid-template-columns:1fr;gap:36px}
    /* stacked, the divider belongs above the second half rather than beside it */
    .close-news{border-inline-start:0;padding-inline-start:0;border-top:1px solid var(--line);padding-top:34px}
  }

  .site-footer{padding-block:clamp(56px,7vw,84px) 32px}
  .foot-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(28px,3.4vw,48px);padding-bottom:clamp(34px,3.6vw,48px);border-bottom:1px solid var(--line-dark);align-items:start}
  .foot-brand .wordmark{display:inline-block;margin-bottom:18px}
  .foot-brand .wordmark img{height:clamp(100px,8.2vw,136px);width:auto;display:block}
  .foot-brand > p{color:#fff;max-width:34ch;font-size:15px}
  /* centred column under the grid, so the code reads as a deliberate invitation rather
     than a footnote in the corner */
  .qr{display:flex;flex-direction:column;align-items:center;gap:12px;justify-self:center;max-width:100%}
  /* the QR PNG already carries its own quiet zone, so keep the frame padding tight
     and the box larger, or the code reads tiny inside a big white square */
  .qr-box{width:clamp(150px,15vw,215px);height:clamp(150px,15vw,215px);background:var(--paper);border-radius:8px;padding:8px;color:var(--navy);flex:none}
  .qr-box svg,.qr-box img{width:100%;height:100%;display:block}
  .qr span{font-size:13.5px;color:#fff;letter-spacing:.02em;line-height:1.5;text-align:center}

  .foot-col a,.foot-visit p{display:block;color:#fff;font-size:15px;margin-bottom:13px;max-width:none}
  .foot-col a:hover{color:var(--gold-bright)}
  .foot-visit p{color:#fff}
  .offices{margin-top:24px}
  .offices-label{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:color-mix(in srgb, var(--gold-bright) 62%, #fff)}
  .offices-list{display:flex;flex-wrap:wrap;gap:8px 14px;margin-top:12px}
  .offices-list.i18n-ar{display:none}
  :global([dir="rtl"]) .offices-list.i18n-en{display:none}
  :global([dir="rtl"]) .offices-list.i18n-ar{display:flex}
  .offices-list span{font-size:13.5px;color:#fff}

  .foot-bottom{display:flex;justify-content:space-between;align-items:center;padding-top:26px;flex-wrap:wrap;gap:14px}
  .foot-bottom > span{font-size:12.5px;color:#fff}
  .foot-legal{display:flex;gap:22px}
  .foot-legal a{font-size:12.5px;color:#fff}
  .foot-legal a:hover{color:var(--gold-bright)}

  @media(max-width:900px){.foot-grid{grid-template-columns:1fr 1fr;gap:36px}.qr{grid-column:1 / -1}}
  @media(max-width:560px){
    .foot-grid{grid-template-columns:1fr}
    .news-form{flex-direction:column}
    /* On a phone these become the navigation, not a footnote. A 15px line with a 13px
       margin gives a 26px target and puts neighbouring links a thumb-width apart; the
       margin becomes padding so the tappable area grows without spreading the column out. */
    .foot-col a{margin-bottom:0;padding-block:11px;min-height:44px;display:flex;align-items:center}
    .foot-legal{gap:8px 22px;flex-wrap:wrap}
    .foot-legal a{padding-block:10px;min-height:40px;display:inline-flex;align-items:center}
  }
</style>

<script>
  // The newsletter box, on every page. Subscribing writes the address into the shared
  // contact book as an opt-in, which is what the mailing tool sends from. It answers in
  // place: leaving the page to say "thank you" for one field is a poor trade.
  const form = document.querySelector<HTMLFormElement>('.news-form');
  const msg = document.querySelector<HTMLElement>('.news-msg');
  if (form && msg) {
    let sending = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      const ar = document.documentElement.getAttribute('dir') === 'rtl';
      const langField = form.querySelector<HTMLInputElement>('.f-lang');
      if (langField) langField.value = ar ? 'ar' : 'en';
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = btn ? btn.innerHTML : '';
      sending = true;
      if (btn) { btn.disabled = true; btn.textContent = ar ? '…' : '…'; }
      msg.hidden = true;
      msg.classList.remove('err');
      try {
        const res = await fetch('/api/enquiry', { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || '');
        form.reset();
        msg.textContent = ar
          ? 'شكراً لكم. سيصلكم كل جديد من برنتوباك على هذا البريد، ويمكنكم إلغاء الاشتراك من أي رسالة.'
          : 'Thank you. News from Printopack will reach you at this address, and every message carries a one-click unsubscribe.';
        msg.hidden = false;
      } catch (err) {
        msg.textContent = (err as Error).message || (ar
          ? 'تعذّر إتمام الاشتراك. يرجى المحاولة مرة أخرى.'
          : 'That did not go through. Please try again.');
        msg.classList.add('err');
        msg.hidden = false;
      } finally {
        sending = false;
        if (btn) { btn.disabled = false; btn.innerHTML = label; }
      }
    });
  }
</script>
